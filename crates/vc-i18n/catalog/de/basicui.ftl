# Texte der Oberfläche zu BASIC (Karte „BASIC“ in den Projekt-Einstellungen: Nummerierung, Bauoption „kompakt“, Syntaxprüfung).
# Kontext: Fehlercode projekt-fehler kommt fertig aus dem Kern.

basicui-karte-titel = BASIC
basicui-nummerierung-titel = Zeilennummern
basicui-nummerierung-hinweis = Zeilen ohne eigene Nummer bekommen beim Bauen fortlaufende Nummern. Eine Zeile „#numbering start=… step=…“ in der Datei geht diesen Werten vor.
basicui-feld-start = Start
basicui-feld-schritt = Schrittweite
basicui-fehler-bereich = Start darf höchstens { $max } sein, die Schrittweite mindestens 1.
basicui-kompakt = Kompakt bauen
basicui-kompakt-hinweis = Entfernt beim Bauen Leerzeichen innerhalb der Anweisungen, wo das nichts ändert (nur Commodore). Der Quelltext bleibt unverändert.
basicui-pruefung = Syntaxprüfung beim Bauen
basicui-pruefung-hinweis = Meldet verdächtige Stellen (Warnungen B150 bis B167) in der Problemliste.
basicui-abgeschaltet = Abgeschaltete Meldungen
basicui-abgeschaltet-hinweis = Kennungen mit Komma getrennt, zum Beispiel B152, B154.
basicui-speichern = Speichern
basicui-gespeichert = BASIC-Einstellungen gespeichert.
