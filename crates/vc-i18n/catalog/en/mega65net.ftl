# User interface texts: mega65net (first draft per docs/glossar-i18n.md; keys are never renamed)

mega65net-ethernet = Ethernet

mega65net-ethernet-uebertragung-gibt-es-nur-fuer = Ethernet transfer is only available for the MEGA65

mega65net-ethernet-werkzeuge-gefunden-el-ftp-mega65 = Ethernet: tools found ({ $el }, { $ftp }), MEGA65 answers ({ $UNCHECKED })

mega65net-exe-e = { $exe }: { $e }

mega65net-exe-nicht-gefunden-pfad-unter-einstellungen = { $exe } not found – enter the path under Settings → Hardware (tool from the mega65-tools package, source: github.com/MEGA65/mega65-tools; the IDE does not ship it)

mega65net-keine-antwort-innerhalb-von-p1-s = no answer within { $p1 } s; output: { $p2 }

mega65net-kopieren-auf-die-sd-karte-geht = Copying to the SD card only works over Ethernet (a separate USB transfer is postponed). Under Settings → Hardware, set the connection “Copy” to Ethernet.

mega65net-n-dateiname-mit-leerzeichen-oder-anfuehrungszeichen = { $n }: a file name with spaces or quotation marks cannot be passed to mega65_ftp – please rename it

mega65net-p-nicht-gefunden-pfad-unter-einstellungen = { $p }: not found (check the path under Settings → Hardware)

mega65net-p1-datei-nicht-gefunden-erst-bauen = { $p1 }: file not found (build first)

mega65net-p1-diskette-nach-sd-kopiert-eingebunden = { $p1 }: disk copied to { $sd }, mounted and program started ({ $UNCHECKED })

mega65net-p1-kein-dateiname = { $p1 }: no file name

mega65net-p1-p2-kopiert-nach-sd-r = { $p1 }: { $p2 } copied to { $sd }; { $r }

mega65net-p1-programm-ueber-ethernet-p2-unchecked = { $p1 }: program over Ethernet { $p2 } ({ $UNCHECKED }) ⏎   { $exe } { $p5 }{ $p6 }

mega65net-p1-sd-image-eingebunden-unchecked = { $p1 }: { $sd_image } mounted ({ $UNCHECKED })

mega65net-sd-ordner-dir-enthaelt-leerzeichen-bitte = SD folder “{ $dir }” contains spaces – please change it

mega65net-what-e-p3-unchecked = { $what }: { $e } ⏎   { $p3 } [{ $UNCHECKED }]

mega65net-what-endete-mit-p2-p3-unchecked = { $what } ended with { $p2 } ({ $p3 }) [{ $UNCHECKED }] ⏎   { $p5 }

mega65net-code-c = Code { $c }

mega65net-signal = Signal

mega65net-ungeprueft-noch-nicht-an-einem-mega65-getestet = unchecked: not tested on a MEGA65 yet

mega65net-gestartet = started

mega65net-geladen = loaded
