# User interface texts: launch (first draft per docs/glossar-i18n.md; keys are never renamed)

launch-atari800-nicht-gefunden-p1-oder-pfad = atari800 not found ({ $p1 } or enter the path under Settings)

launch-auf-der-ultimate-lassen-sich-nur = On the Ultimate you can only start .prg programs and .crt modules (no disk)

launch-ausgabe-des-emulators = Output of the emulator:

launch-cmd-e = { $cmd }: { $e }

launch-cmd-p2 = { $cmd } { $p2 }

launch-der-emulator-hat-sich-sofort-beendet = The emulator quit right away{ $code }. Missing ROM files? See Settings ▸ ROMs.

launch-die-mega65-hardware-spielt-nur-mega65 = The MEGA65 hardware only plays MEGA65 programs

launch-die-ultimate-hardware-spielt-nur-c64 = The Ultimate hardware only plays C64 programs

launch-diskette-auf-hardware-starten-gibt-es = Starting a disk on hardware is only available for the MEGA65

launch-eine-diskette-laesst-sich-nur-ueber = A disk can only be brought to the MEGA65 over Ethernet (Settings → Hardware, connection “Start”)

launch-mega65-einlegen-im-emulator-ist-noch = MEGA65: inserting in the emulator is not implemented yet

launch-mega65-rom-nicht-gefunden = MEGA65 ROM not found

launch-mega65-start-fehlgeschlagen-e = MEGA65 start failed: { $e }

launch-p1-programm-gestartet-start-bei-entry = { $p1 }: program started, start at ${ $entry }

launch-p1-vice-nicht-gefunden = { $p1 } (VICE) not found

launch-prog-vice-nicht-gefunden = { $prog } (VICE) not found

launch-rel-e = { $rel }: { $e }

launch-rueckgabewert-c = , return value { $c }

launch-unbekannter-maschinentyp-k = unknown machine type '{ $k }'

launch-who-modul-gestartet-p2-bytes = { $who }: module started ({ $p2 } bytes)

launch-who-programm-gestartet-p2-bytes = { $who }: program started ({ $p2 } bytes)

launch-xemu-programm-wird-mit-prg-im = Xemu (the program is loaded and started with -prg in C65 mode)

launch-xemu-programm-wird-ueber-den-monitor = Xemu (the program is loaded through the monitor, start at ${ $entry }; takes about 15 s)
