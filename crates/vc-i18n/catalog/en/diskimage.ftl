# User interface texts: diskimage (first draft per docs/glossar-i18n.md; keys are never renamed)

diskimage-atr-dos-2 = ATR (DOS 2)

diskimage-aus-name-disassembliert-daten-koennen-als = ; disassembled from { $name } (data may appear as instructions – please check)

diskimage-basic-p1-p2-zeilen-als-quelltext = BASIC ({ $p1 }, { $p2 } lines) taken over as source code

diskimage-datei-zu-kurz = File too short

diskimage-eintrag-nicht-vorhanden = Entry does not exist

diskimage-final-name-e = { $final_name }: { $e }

diskimage-hardware-datenbank-data-nicht-gefunden = Hardware database (data/) not found

diskimage-hinter-dem-basic-programm-folgen-p1 = { $p1 } bytes follow the BASIC program (machine code?): the original is kept

diskimage-name-unbekanntes-imageformat-erwartet-d64-d71 = { $name }: unknown image format (expected .d64, .d71, .d81 or .atr)

diskimage-p1-adresse-n-in-poke-peek = { $p1 } address(es) in POKE/PEEK/SYS/WAIT are chip registers and can be written as hex (editor: Edit ▸ Hex suggestions ...; nothing was changed)

diskimage-p1-bloecke-frei = { $p1 } blocks free

diskimage-p1-sektoren-frei = { $p1 } sectors free

diskimage-quelltext-durch-disassemblieren-erzeugt-daten-koennen = Source code created by disassembling (data may appear as instructions)

diskimage-ungueltiger-dateiname-name = invalid file name “{ $name }”

diskimage-ungueltiger-zielordner-dir = invalid destination folder “{ $dir }”
