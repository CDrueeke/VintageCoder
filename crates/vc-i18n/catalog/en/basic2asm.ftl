# Convert BASIC to assembler (English)

basic2asm-aus-e = { $aus }: { $e }
basic2asm-basic-in-assembler-e = BASIC to assembler: { $e }
basic2asm-basic-in-assembler-p1-fehler-siehe = BASIC to assembler: { $p1 } errors, see Problems
basic2asm-basic-in-assembler-umwandeln-erst-eine = Convert BASIC to assembler: open a BASIC file (.bas) first.
basic2asm-basic-in-assembler-ziel-ziel-ist = BASIC to assembler: target "{ $ziel }" is not implemented yet.
basic2asm-rel-aus-stufe-p3-p4-zeilen = { $rel } → { $aus }: level { $p3 }, { $p4 } lines, modules: { $p5 }{ $p6 }

basic2asm-p1-hinweis-e-in-den-problemen = · { $p1 } note(s) in Problems
