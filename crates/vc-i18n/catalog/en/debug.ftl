# Debugger messages (English)

debug-der-emulator-antwortet-nicht-zeitueberschreitung-versuche = The emulator does not answer (timeout). Try again or end the session.
debug-der-emulator-meldet-einen-systemfehler-p1 = The emulator reports a system error ({ $p1 }).
debug-die-verbindung-zum-emulator-ist-verloren = The connection to the emulator is lost (it was closed or crashed). The debug session ends.
debug-meinst-du-t = Do you mean ${ $t }?
debug-momentaufnahme-e = Snapshot: { $e }
debug-momentaufnahme-gespeichert-x = Snapshot saved: { $x }
debug-t-ist-kein-gueltiger-ausdruck-roh = "{ $t }" is not a valid expression ({ $roh }). Examples: $d020, a, sp, start, [$d020] + 1.
debug-t-ist-keine-adresse-beispiele-d020 = "{ $t }" is not an address. Examples: D020, $d020, 0x0400 or a symbol such as start.
debug-t-ist-weder-register-noch-symbol = "{ $t }" is neither a register nor a symbol.{ $rat } Examples: $d020 (byte at this address), a, x, y, sp, pc, start (symbol), [$d020] + 1.
