# User interface texts: projfile (first draft per docs/glossar-i18n.md; keys are never renamed)

projfile-art-e = { $art }: { $e }

projfile-disk-f-ist-keine-quelldatei-des = disk: '{ $f }' is not a source file of the project

projfile-disk-unbekanntes-format-p1-d64-d71 = disk: unknown format '{ $p1 }' (d64, d71, d81, atr)

projfile-diskette-keine-programme-ausgewaehlt = Disk: no programs selected

projfile-diskettenformat-f-unbekannt-d64-d71-d81 = Disk format '{ $f }' unknown (d64, d71, d81, atr)

projfile-f-datei-fehlt = { $f }: file missing

projfile-f-mehrfach-als-quelle-eingetragen = { $f }: listed as a source more than once

projfile-f-unbekannte-art-kind-asm-oder = { $f }: unknown kind '{ $kind }' (asm or basic)

projfile-folders-p1-ist-kein-gueltiger-ordner = folders: '{ $p1 }' is not a valid folder

projfile-folders-target-t-bei-p2-ist = folders: target '{ $t }' at '{ $p2 }' is not defined

projfile-folders-unbekannte-rolle-p1-bei-p2 = folders: unknown role '{ $p1 }' at '{ $p2 }'

projfile-kein-target-mindestens-ein-zielsystem-eintragen = No target: enter at least one target system

projfile-layout-d-ist-kein-gueltiger-ordner = layout: '{ $d }' is not a valid folder (relative, without ..)

projfile-layout-unbekannte-kategorie-k = layout: unknown category '{ $k }'

projfile-main-m-ist-keine-quelldatei-des = main: '{ $m }' is not a source file of the project

projfile-o-und-f-erzeugen-dieselbe-ausgabedatei = { $o } and { $f } produce the same output file (same file name)

projfile-out-rel-e = { $out_rel }: { $e }

projfile-p-b = P{ $b }

projfile-p1-datei-fehlt-abschnitt-assets = { $p1 }: file missing (section assets)

projfile-projektname-fehlt-bitte-einen-namen-eingeben = Project name missing: please enter a name

projfile-rules-muster-fehlt = rules: pattern missing

projfile-rules-p1-ist-kein-gueltiger-ordner = rules: '{ $p1 }' is not a valid folder (at '{ $p2 }')

projfile-rules-unbekannte-kategorie-p1-bei-p2 = rules: unknown category '{ $p1 }' at '{ $p2 }'

projfile-quellgruppe-f-target-t-ist-nicht-definiert = Source group { $f }: target '{ $t }' is not defined

projfile-rolle-quelltext = Source code

projfile-rolle-ressourcen = Resources

projfile-rolle-daten = Data

projfile-rolle-doku = Documentation

projfile-rolle-tests = Tests

projfile-rolle-werkzeuge = Tools

projfile-diskette-nicht-erstellt-nicht-alle-programme = Disk not created: not all programs of the project were built

projfile-pfad-unzulaessig = Invalid path '{ $pfad }' in the project file: only relative paths inside the project folder are allowed (no '..', no absolute path, no drive, no link pointing outside)
