# User interface texts: fileops (first draft per docs/glossar-i18n.md; keys are never renamed)

fileops-der-name-ist-leer = The name is empty.

fileops-der-pfad-darf-kein-und-keine = The path must not contain “..” or empty parts.

fileops-der-pfad-muss-innerhalb-des-projekts = The path must be inside the project.

fileops-ein-ordner-laesst-sich-nicht-in = A folder cannot be moved into itself.

fileops-namen-mit-fuehrendem-punkt-sind-im = Names with a leading dot are hidden in the file tree.

fileops-new-e = { $new }: { $e }

fileops-new-gibt-es-schon = { $new } already exists.

fileops-old-e = { $old }: { $e }

fileops-old-gibt-es-nicht = { $old } does not exist.

fileops-rel-e = { $rel }: { $e }

fileops-rel-gibt-es-nicht = { $rel } does not exist.

fileops-rel-gibt-es-schon = { $rel } already exists.
fileops-papierkorb-fehlgeschlagen = { $rel } could not be moved to the trash. The file was not deleted.
