# Hex suggestions for BASIC (English)

hexdlg-abbrechen = Cancel
hexdlg-alle = All
hexdlg-basic-hex-vorschlaege-fuer-adressen = BASIC: Hex suggestions for addresses
hexdlg-dezimaladressen-bekannter-register-als-hex-schreiben = Write decimal addresses of known registers as hex. Only what you tick is changed.
hexdlg-hex-vorschlaege-e = Hex suggestions: { $e }
hexdlg-hex-vorschlaege-keine-dezimaladresse-eines-bekannten = Hex suggestions: no decimal address of a known register found.
hexdlg-hex-vorschlaege-oeffne-zuerst-eine-basic = Hex suggestions: open a BASIC file first.
hexdlg-keine = None
hexdlg-n-uebernehmen = Apply { $n }
hexdlg-p1-adresse-n-als-hex-geschrieben = { $p1 } address(es) written as hex ({ $rel }); Undo reverts it in one step.
hexdlg-rechenausdruecke-data-zeilen-und-zeichenketten-kommen = Expressions, DATA lines and strings are never touched.
hexdlg-zeile-p1 = Line { $p1 }
