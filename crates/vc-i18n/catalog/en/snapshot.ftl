# User interface texts: snapshot (first draft per docs/glossar-i18n.md; keys are never renamed)

snapshot-antic-modus-p1-display-liste-dl = ANTIC mode { $p1 }, display list ${ $dl }

snapshot-antic-modus-p1-wird-nicht-unterstuetzt = ANTIC mode { $p1 } is not supported (only mode 2, 40×24 text characters).

snapshot-atari-die-farben-und-zeiger-stammen = Atari: The colors and pointers come from the shadow registers of the operating system. Programs with their own display list or their own interrupt may need their addresses and colors adjusted by hand.

snapshot-bitmap-modus-kein-textbildschirm-screen-und = Bitmap mode: no text screen – screen and character set are omitted (sprites are still possible).

snapshot-der-aktuelle-antic-modus-wird-nicht = The current ANTIC mode is not supported.

snapshot-der-aktuelle-modus-ist-kein-textbildschirm = The current mode is not a text screen.

snapshot-der-zeichensatz-liegt-im-betriebssystem-rom = The character set is in the operating system ROM ($E000) and is read from there.

snapshot-der-zeichensatz-liegt-im-zeichen-rom = The character set is in the character ROM (standard font) and is read from there.

snapshot-display-liste-bei-dl-enthaelt-keinen = The display list at ${ $dl } contains no LMS instruction.

snapshot-ecm-modus-es-werden-nur-64 = ECM mode: only 64 characters are shown; the screen is read unchanged.

snapshot-keine-display-liste-mit-lms-gefunden = no display list with LMS found

snapshot-mixed-kachelstellen-hatten-gemischte-farben-es = { $mixed } tile positions had mixed colors (the color of the first visible cell applies).

snapshot-momentaufnahme-system-s-wird-nicht-unterstuetzt = Snapshot: system '{ $s }' is not supported (C64 and Atari 8-bit)

snapshot-nicht-lesbar = not readable

snapshot-nichts-zu-speichern-adresse-fuer-screen = Nothing to save: address for screen or character set is missing (character set in ROM?).

snapshot-p1-kacheln-raster-ab-spalte-ox = { $p1 } tiles, grid from column { $ox }, row { $oy }.

snapshot-p1-p2-vic-bank-bank-p4 = { $p1 }{ $p2 } · VIC bank { $bank } (${ $p4 }–${ $p5 })

snapshot-profil-id-fehlt = Profile '{ $id }' is missing

snapshot-system-s-wird-nicht-unterstuetzt = System '{ $s }' is not supported

snapshot-zu-viele-verschiedene-kacheln-p1-der = Too many different tiles ({ $p1 }); the screen cannot be shown as a tile map

snapshot-bitmap = Bitmap

snapshot-ecm = (ECM)

snapshot-multicolor = (multicolor)

snapshot-text = Text
