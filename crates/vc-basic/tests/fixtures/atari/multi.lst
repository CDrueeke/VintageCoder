5 A=USR(1536)›10 DIM A$(10),B(5):A$="HI":B(1)=2:A$(1,2)="X"›20 IF A=1 THEN 100›30 IF A=1 THEN PRINT 2:GOTO 40›40 FOR I=1 TO 10 STEP 2:NEXT I›50 ON A GOTO 10,20›60 PRINT #1;A;"X",B(2)›70 REM TEST›80 DATA 1,2,HELLO›90 IF A$="X" AND NOT(A=1) THEN GOSUB 10›100 X=-2+ABS(PEEK(53279)):Y$=STR$(X)›110 POKE 710,A:SOUND 0,1,2,3›120 GRAPHICS 0:PRINT CHR$(65);A$(1,1);LEN(A$)›130 INPUT B$:OPEN #1,4,0,"K:":GET #1,Z›140 LET Q=2^3*4/5<>1:TRAP 10:POP:END›