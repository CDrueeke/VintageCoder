    "EX-HELLO": {
      "kind": "examples",
      "projects": ["pet/hello", "pet/basic_hello", "cbm2/basic_hello", "mega65/hello", "mega65/cputest",
                   "*/basic_native", "c64/basic_langenamen", "atari/turbo_basic", "*/border"]
    },
    "EX-JUMPRUN": {
      "kind": "examples",
      "projects": ["*/jumprun"],
