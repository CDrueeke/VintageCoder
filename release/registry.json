  "examples_ignore": ["examples/c64/lib/**"],
  "examples_exclude_dirs": ["rom", "snapshot", "dump", "build"],

  "notes": ["BAS-B2A", "ASM-CART", "ASM-45GS02"],

  "preview_ok": ["SYS-PET", "SYS-CBM2"],
  "forbidden_ide_words_parts": [["Inte", "lliJ"], ["CL", "ion"], ["Rust", "Rover"], ["PyC", "harm"], ["WebS", "torm"], ["Ecl", "ipse"], ["Sub", "lime"], ["Visual", " Studio"], ["VS", " Code"], ["VSC", "ode"], ["Neo", "vim"], ["Em", "acs"], ["Xc", "ode"]],

  "ide_words_allow_technical": ["editors/ext/"],
  "forbidden_emulator_files": ["x64sc", "x64", "x128", "xplus4", "xvic", "xpet", "xcbm2", "xcbm5x0", "atari800", "altirra", "altirra64", "fujisan", "xmega65", "xemu"]
