    "STU-SPRITE":  { "kind": "studio", "id": "sprite", "help": ["sprite", "sprites"],  "needs": ["IDE-APP"] },
    "STU-CHAR":    { "kind": "studio", "id": "char", "help": ["charset", "zeichensatz"],    "needs": ["IDE-APP"] },
    "STU-SCREEN":  { "kind": "studio", "id": "screen", "help": ["screen", "bildschirm-kacheln"],  "needs": ["IDE-APP"] },
    "STU-TILES":   { "kind": "studio", "id": "tiles", "help": ["tiles", "bildschirm-kacheln"],   "needs": ["IDE-APP"],
                     "soft": [["STU-CHAR", "Kachelsaetze verweisen auf Zeichensaetze"], ["STU-SCREEN", "Screen-Banks verweisen auf Bildschirme"]] },
    "STU-PALETTE": { "kind": "studio", "id": "palette", "help": ["paletten"], "needs": ["IDE-APP"],
                     "needs_any": ["SYS-C64", "SYS-C128", "SYS-PLUS4", "SYS-C16", "SYS-VC20", "SYS-ATARI", "SYS-MEGA65"] },
    "STU-TRACKER": { "kind": "studio", "id": "tracker", "help": ["tracker", "envelope"], "needs": ["IDE-APP"],
                     "needs_any": ["SYS-C64", "SYS-C128", "SYS-MEGA65", "SYS-ATARI"] },
    "STU-PLAY":    { "kind": "studio", "id": "play", "help": ["play", "play-tracker"],    "needs": ["IDE-APP"],
                     "needs_any": ["SYS-C64", "SYS-C128", "SYS-MEGA65", "SYS-ATARI"] },
    "STU-DISK":    { "kind": "studio", "id": "disk", "help": ["disks", "disk-studio"],    "needs": ["IDE-APP"] },
    "STU-MEMMAP":  { "kind": "studio", "id": "memmap", "help": ["memmap"],  "needs": ["IDE-APP"] },
    "STU-EXTRACT": { "kind": "studio", "id": "extract", "help": [], "needs": ["IDE-APP"] },

    "EMU-VICE":     { "kind": "link", "help": ["emulators"], "id": "vice", "needs_any": ["SYS-C64", "SYS-C128", "SYS-VC20", "SYS-PLUS4", "SYS-C16", "SYS-PET", "SYS-CBM2"],
                      "files": ["data/args/vice-*.json"] },
    "EMU-ATARI800": { "kind": "link", "help": ["emulators"], "id": "atari800", "needs": ["SYS-ATARI"], "files": ["data/args/atari800.json"] },
    "EMU-ALTIRRA":  { "kind": "link", "help": ["emulators"], "id": "altirra",  "needs": ["SYS-ATARI"], "files": ["data/args/altirra.json"] },
    "EMU-FUJISAN":  { "kind": "link", "help": ["emulators"], "id": "fujisan",  "needs": ["SYS-ATARI"], "files": [] },
    "EMU-XEMU":     { "kind": "link", "help": ["emulators"], "id": "xemu",     "needs": ["SYS-MEGA65"], "files": ["data/args/xemu.json"] },
    "HW-ULTIMATE":  { "kind": "link", "id": "ultimate", "needs": ["SYS-C64"], "files": [] },
    "HW-MEGA65":    { "kind": "link", "id": "mega65",   "needs": ["SYS-MEGA65"], "files": [] },

    "SYS-C64": {
      "kind": "target", "id": "c64", "example_dir": "c64",
      "files": [
