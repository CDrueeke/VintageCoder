{
  "$schema": "https://vintagecoder.dev/schema/chip-1.json",
  "id": "ted",
  "name": "TED 7360/8360",
  "window": {
    "space": "cpu16",
    "start": "$FF00",
    "end": "$FF3F"
  },
  "regs": [
    {"name": "timer1_lo", "addr": "$FF00", "access": "rw", "doc": "Timer 1 Low"},
    {"name": "timer1_hi", "addr": "$FF01", "access": "rw", "doc": "Timer 1 High"},
    {"name": "timer2_lo", "addr": "$FF02", "access": "rw", "doc": "Timer 2 Low"},
    {"name": "timer2_hi", "addr": "$FF03", "access": "rw", "doc": "Timer 2 High"},
    {"name": "timer3_lo", "addr": "$FF04", "access": "rw", "doc": "Timer 3 Low"},
    {"name": "timer3_hi", "addr": "$FF05", "access": "rw", "doc": "Timer 3 High"},
    {"name": "ctrl1", "addr": "$FF06", "access": "rw", "doc": "Steuerung 1: Bit 7 Rasterzeile 8, Bit 6 ECM, Bit 5 BMM, Bit 4 Anzeige an, Bit 3 24/25 Zeilen, Bit 0-2 Y-Scroll"},
    {"name": "ctrl2", "addr": "$FF07", "access": "rw", "doc": "Steuerung 2: Bit 7 Reverse aus, Bit 6 PAL/NTSC, Bit 5 Freeze, Bit 4 Multicolor, Bit 3 38/40 Spalten, Bit 0-2 X-Scroll"},
    {"name": "keylatch", "addr": "$FF08", "access": "rw", "doc": "Tastatur-Latch (Joystick/Tastatur lesen)"},
    {"name": "irq_status", "addr": "$FF09", "access": "rw", "doc": "IRQ-Status (Schreiben 1 löscht)"},
    {"name": "irq_mask", "addr": "$FF0A", "access": "rw", "doc": "IRQ-Maske; Bit 0 = Rasterzeile Bit 8"},
    {"name": "raster_cmp", "addr": "$FF0B", "access": "rw", "doc": "Rasterzeile für IRQ, Bit 0-7"},
    {"name": "cursor_hi", "addr": "$FF0C", "access": "rw", "doc": "Cursorposition High (Bit 0-1)"},
    {"name": "cursor_lo", "addr": "$FF0D", "access": "rw", "doc": "Cursorposition Low"},
    {"name": "snd1_lo", "addr": "$FF0E", "access": "rw", "doc": "Ton 1 Frequenz Low"},
    {"name": "snd2_lo", "addr": "$FF0F", "access": "rw", "doc": "Ton 2 Frequenz Low"},
    {"name": "snd2_hi", "addr": "$FF10", "access": "rw", "doc": "Ton 2 Frequenz High (Bit 0-1)"},
    {"name": "snd_ctrl", "addr": "$FF11", "access": "rw", "doc": "Ton: Bit 7 D/A-Modus, Bit 6 Ton 2 Rauschen, Bit 5 Ton 2 an, Bit 4 Ton 1 an, Bit 0-3 Lautstärke"},
    {"name": "bitmap_snd", "addr": "$FF12", "access": "rw", "doc": "Bit 0-1 Ton 1 Frequenz High, Bit 2 Zeichensatz ROM/RAM, Bit 3-5 Bitmap-Adresse"},
    {"name": "charset", "addr": "$FF13", "access": "rw", "doc": "Bit 2-7 Zeichensatzadresse; Bit 1 ROM-Status, Bit 0 Taktstatus"},
    {"name": "video_base", "addr": "$FF14", "access": "rw", "doc": "Bit 3-7 Videomatrix-Adresse"},
    {"name": "bg0", "addr": "$FF15", "access": "rw", "doc": "Hintergrundfarbe 0"},
    {"name": "bg1", "addr": "$FF16", "access": "rw", "doc": "Hintergrundfarbe 1"},
    {"name": "bg2", "addr": "$FF17", "access": "rw", "doc": "Hintergrundfarbe 2"},
    {"name": "bg3", "addr": "$FF18", "access": "rw", "doc": "Hintergrundfarbe 3"},
    {"name": "border", "addr": "$FF19", "access": "rw", "doc": "Rahmenfarbe"},
    {"name": "charpos_hi", "addr": "$FF1A", "access": "rw", "doc": "Zeichenposition Reload High (Bit 0-1)"},
    {"name": "charpos_lo", "addr": "$FF1B", "access": "rw", "doc": "Zeichenposition Reload Low"},
    {"name": "raster_hi", "addr": "$FF1C", "access": "rw", "doc": "Rasterzeile Bit 8"},
    {"name": "raster_lo", "addr": "$FF1D", "access": "r", "doc": "Rasterzeile Bit 0-7"},
    {"name": "hcount", "addr": "$FF1E", "access": "r", "doc": "Horizontaler Zähler (Bit 1-8)"},
    {"name": "vsub_blink", "addr": "$FF1F", "access": "rw", "doc": "Bit 3-6 Blinkzähler, Bit 0-2 vertikale Unterzeile"},
    {"name": "rom_on", "addr": "$FF3E", "access": "w", "doc": "Schreibzugriff schaltet ROM ein"},
    {"name": "ram_on", "addr": "$FF3F", "access": "w", "doc": "Schreibzugriff schaltet RAM ein"}
  ]
}
