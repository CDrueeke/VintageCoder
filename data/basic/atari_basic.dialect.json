{
  "$schema": "https://vintagecoder.dev/schema/basic-dialect-1.json",
  "id": "atari_basic",
  "family": "atari",
  "backend": "memory_image",
  "varSigChars": 120,
  "maxLineLen": 255,
  "numberStorage": "bcd6",
  "floatFormat": "bcd6",
  "lomemOffset": "$0100",
  "statements": [
    ["REM", "$00"],
    ["DATA", "$01"],
    ["INPUT", "$02"],
    ["COLOR", "$03"],
    ["LIST", "$04"],
    ["ENTER", "$05"],
    ["LET", "$06"],
    ["IF", "$07"],
    ["FOR", "$08"],
    ["NEXT", "$09"],
    ["GOTO", "$0A"],
    ["GO TO", "$0B"],
    ["GOSUB", "$0C"],
    ["TRAP", "$0D"],
    ["BYE", "$0E"],
    ["CONT", "$0F"],
    ["COM", "$10"],
    ["CLOSE", "$11"],
    ["CLR", "$12"],
    ["DEG", "$13"],
    ["DIM", "$14"],
    ["END", "$15"],
    ["NEW", "$16"],
    ["OPEN", "$17"],
    ["LOAD", "$18"],
    ["SAVE", "$19"],
    ["STATUS", "$1A"],
    ["NOTE", "$1B"],
    ["POINT", "$1C"],
    ["XIO", "$1D"],
    ["ON", "$1E"],
    ["POKE", "$1F"],
    ["PRINT", "$20"],
    ["RAD", "$21"],
    ["READ", "$22"],
    ["RESTORE", "$23"],
    ["RETURN", "$24"],
    ["RUN", "$25"],
    ["STOP", "$26"],
    ["POP", "$27"],
    ["?", "$28"],
    ["GET", "$29"],
    ["PUT", "$2A"],
    ["GRAPHICS", "$2B"],
    ["PLOT", "$2C"],
    ["POSITION", "$2D"],
    ["DOS", "$2E"],
    ["DRAWTO", "$2F"],
    ["SETCOLOR", "$30"],
    ["LOCATE", "$31"],
    ["SOUND", "$32"],
    ["LPRINT", "$33"],
    ["CSAVE", "$34"],
    ["CLOAD", "$35"]
  ],
  "functions": [
    ["STR$", "$3D"],
    ["CHR$", "$3E"],
    ["USR", "$3F"],
    ["ASC", "$40"],
    ["VAL", "$41"],
    ["LEN", "$42"],
    ["ADR", "$43"],
    ["ATN", "$44"],
    ["COS", "$45"],
    ["PEEK", "$46"],
    ["SIN", "$47"],
    ["RND", "$48"],
    ["FRE", "$49"],
    ["EXP", "$4A"],
    ["LOG", "$4B"],
    ["CLOG", "$4C"],
    ["SQR", "$4D"],
    ["SGN", "$4E"],
    ["ABS", "$4F"],
    ["INT", "$50"],
    ["PADDLE", "$51"],
    ["STICK", "$52"],
    ["PTRIG", "$53"],
    ["STRIG", "$54"]
  ],
  "ops": {
    "numConst": "$0E",
    "strConst": "$0F",
    "comma": "$12",
    "dollar": "$13",
    "colon": "$14",
    "semicolon": "$15",
    "eol": "$16",
    "goto": "$17",
    "gosub": "$18",
    "to": "$19",
    "step": "$1A",
    "then": "$1B",
    "hash": "$1C",
    "le": "$1D",
    "ne": "$1E",
    "ge": "$1F",
    "lt": "$20",
    "gt": "$21",
    "eq": "$22",
    "pow": "$23",
    "mul": "$24",
    "add": "$25",
    "sub": "$26",
    "div": "$27",
    "not": "$28",
    "or": "$29",
    "and": "$2A",
    "lparen": "$2B",
    "rparen": "$2C",
    "assignNum": "$2D",
    "assignStr": "$2E",
    "sle": "$2F",
    "sne": "$30",
    "sge": "$31",
    "slt": "$32",
    "sgt": "$33",
    "seq": "$34",
    "uplus": "$35",
    "uminus": "$36",
    "strLparen": "$37",
    "arrLparen": "$38",
    "dimArrLparen": "$39",
    "fnLparen": "$3A",
    "dimStrLparen": "$3B",
    "subComma": "$3C",
    "implicitLet": "$36"
  }
}
