    ["/", "$AD"],
    ["^", "$AE"],
    ["AND", "$AF"],
    ["OR", "$B0"],
    [">", "$B1"],
    ["=", "$B2"],
    ["<", "$B3"],
    ["SGN", "$B4"],
    ["INT", "$B5"],
    ["ABS", "$B6"],
    ["USR", "$B7"],
    ["FRE", "$B8"],
    ["POS", "$B9"],
    ["SQR", "$BA"],
    ["RND", "$BB"],
    ["LOG", "$BC"],
    ["EXP", "$BD"],
    ["COS", "$BE"],
