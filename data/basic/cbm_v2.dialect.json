{
  "$schema": "https://vintagecoder.dev/schema/basic-dialect-1.json",
  "id": "cbm_v2",
  "family": "cbm",
  "backend": "linked_lines",
  "loadAddr": "$0801",
  "varSigChars": 2,
  "reservedVars": ["ST", "TI", "DS"],
  "maxLineLen": 80,
  "hardMaxLineLen": 255,
  "numberStorage": "ascii_text",
  "floatFormat": "mbf5",
  "capabilities": {"doLoop": false, "graphic": false, "spriteCmds": false, "trap": false, "restoreLine": false},
  "tokens": [
    ["END", "$80"],
    ["FOR", "$81"],
    ["NEXT", "$82"],
