  "control": [
    ["blk", "$90"],
    ["wht", "$05"],
    ["red", "$1C"],
    ["cyn", "$9F"],
    ["pur", "$9C"],
    ["grn", "$1E"],
    ["blu", "$1F"],
    ["yel", "$9E"],
    ["orng", "$81"],
    ["brn", "$95"],
    ["lred", "$96"],
    ["gry1", "$97"],
    ["gry2", "$98"],
    ["lgrn", "$99"],
