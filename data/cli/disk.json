    },
    {
      "id": "atr",
      "usage": "vcc disk atr -o <out.atr> [--add <datei[:NAME.EXT]>]...",
      "summary": "ATR-Image (Atari DOS 2) mit Dateien anlegen",
      "args": [],
      "option_groups": [ { "id": "image", "label": "Image" }, { "id": "allgemein", "label": "Allgemein" } ],
      "options": [
        { "flag": "-o", "short": "", "value": "datei", "group": "image", "help": "Ausgabedatei des Images.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": true },
        { "flag": "--add", "short": "", "value": "datei[:NAME.EXT]", "group": "image", "help": "Datei in das DOS-2-Dateisystem schreiben, optional unter anderem Namen.", "choices": [], "default": "", "default_text": "Dateiname in Großbuchstaben, mit Endung", "repeat": true, "required": false },
        { "flag": "--name", "short": "", "value": "name", "group": "allgemein", "help": "Wird angenommen, hat bei ATR-Images keine Wirkung.", "choices": [], "default": "VINTAGECODER", "default_text": "", "repeat": false, "required": false },
        { "flag": "--id", "short": "", "value": "id", "group": "allgemein", "help": "Wird angenommen, hat bei ATR-Images keine Wirkung.", "choices": [], "default": "VC", "default_text": "", "repeat": false, "required": false },
        { "flag": "--keep", "short": "", "value": "", "group": "allgemein", "help": "Wird angenommen und ignoriert.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": false },
        { "flag": "--data-dir", "short": "", "value": "pfad", "group": "allgemein", "help": "Ordner der Hardware-Datenbank; sonst VC_DATA oder neben dem Programm.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": false }
      ],
      "examples": [
        { "title": "ATR mit einer Datei als AUTORUN.SYS", "cmd": "vcc disk atr -o spiel.atr --add jumprun.xex:AUTORUN.SYS" }
      ],
      "notes": ["Das Image ist 90 KB groß (720 Sektoren zu 128 Byte). Eine bootbare Diskette ohne Dateisystem erzeugt die Form `atr-boot`."],
      "see_also": ["import", "build"]
    },
    {
      "id": "atr-boot",
      "usage": "vcc disk atr -o <out.atr> --boot <prog.xex>",
      "summary": "bootbare ATR-Diskette aus einem XEX-Programm",
      "args": [],
      "option_groups": [ { "id": "image", "label": "Image" }, { "id": "allgemein", "label": "Allgemein" } ],
      "options": [
        { "flag": "-o", "short": "", "value": "datei", "group": "image", "help": "Ausgabedatei des Images.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": true },
        { "flag": "--boot", "short": "", "value": "prog.xex", "group": "image", "help": "XEX-Programm, das die Diskette beim Einschalten lädt (Boot-Lader aus der Hardware-Datenbank).", "choices": [], "default": "", "default_text": "", "repeat": false, "required": true },
        { "flag": "--data-dir", "short": "", "value": "pfad", "group": "allgemein", "help": "Ordner der Hardware-Datenbank; sie liefert den Boot-Lader.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": false }
      ],
      "examples": [
        { "title": "bootbare Diskette", "cmd": "vcc disk atr -o jumprun.atr --boot jumprun.xex" }
      ],
      "notes": ["`--boot` lässt sich nicht mit `--add` verbinden: die Boot-Diskette hat kein Dateisystem. `vcc disk list` meldet das entsprechend.", "Eine Datei ohne XEX-Kennung ($FFFF am Anfang) führt zu einem Fehler."],
      "see_also": ["build"]
    },
    {
      "id": "list",
      "usage": "vcc disk list <image.d64|d71|d81|atr>",
      "summary": "Verzeichnis eines Images zeigen und prüfen",
      "args": [ { "name": "image", "required": true, "repeat": false, "help": "Diskettenimage; die Endung (d64, d71, d81, atr) bestimmt das Format." } ],
      "option_groups": [],
      "options": [],
      "examples": [
        { "title": "Verzeichnis anzeigen", "cmd": "vcc disk list spiel.d64" },
        { "title": "Atari-Diskette anzeigen", "cmd": "vcc disk list spiel.atr" }
      ],
      "notes": ["Commodore: Blockzahl, Name, Dateiart und freie Blöcke. Atari: Name, Sektoren, Startsektor, `*` für geschützte Dateien und freie Sektoren.", "Die Prüfung (BAM bzw. VTOC, Verzeichnis, Dateiketten) meldet Abweichungen als „Problem:“ auf stderr."],
      "exit": { "0": "fehlerfrei", "1": "Datei nicht lesbar oder Problem im Image gefunden", "2": "falscher Aufruf" },
      "see_also": ["import"]
    },
    {
      "id": "extract",
      "usage": "vcc disk extract <image.d64|d71|d81|atr> <NAME> [-o <datei>]",
      "summary": "eine Datei aus einem Image holen",
      "args": [
        { "name": "image", "required": true, "repeat": false, "help": "Diskettenimage; die Endung bestimmt das Format." },
        { "name": "NAME", "required": true, "repeat": false, "help": "Dateiname auf der Diskette." }
      ],
      "option_groups": [],
      "options": [
        { "flag": "-o", "short": "", "value": "datei", "group": "", "help": "Zieldatei.", "choices": [], "default": "", "default_text": "Commodore: NAME klein mit Endung .prg; Atari: NAME klein", "repeat": false, "required": false }
      ],
      "examples": [
        { "title": "Programm aus D64 holen", "cmd": "vcc disk extract spiel.d64 JUMPRUN -o jumprun.prg" },
        { "title": "Datei aus ATR holen", "cmd": "vcc disk extract spiel.atr AUTORUN.SYS -o autorun.sys" }
      ],
      "see_also": ["import"]
    }
  ]
}
