        { "flag": "--id", "short": "", "value": "id", "group": "image", "help": "Disketten-ID im Verzeichniskopf.", "choices": [], "default": "VC", "default_text": "", "repeat": false, "required": false },
        { "flag": "--add", "short": "", "value": "datei[:NAME]", "group": "image", "help": "Programmdatei (PRG) auf die Diskette schreiben, optional unter anderem Namen.", "choices": [], "default": "", "default_text": "Dateiname ohne Endung, in Großbuchstaben", "repeat": true, "required": false },
