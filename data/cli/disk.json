{
  "command": "disk",
  "group": "daten",
  "summary": "Diskettenimages anlegen, auflisten und Dateien herausholen",
  "description": [
    "Arbeitet mit den Formaten D64 (1541), D71 (1571), D81 (1581) und ATR (Atari, DOS 2). Die Art des Images folgt beim Anlegen aus der Unterform, beim Auflisten und Extrahieren aus der Dateiendung.",
    "Bei `--add` trennt der erste Doppelpunkt Datei und Diskettenname. Ein Pfad mit Laufwerksbuchstaben (C:\\...) lässt sich deshalb nicht zusammen mit einem Namen angeben; dann relative Pfade verwenden."
  ],
  "aliases": [],
  "forms": [
    {
      "id": "d64",
      "usage": "vcc disk d64 -o <out.d64> [--name <name>] [--id <id>] [--add <datei[:NAME]>]...",
      "summary": "D64-Image (1541) mit Programmen anlegen",
      "args": [],
      "option_groups": [ { "id": "image", "label": "Image" }, { "id": "allgemein", "label": "Allgemein" } ],
      "options": [
        { "flag": "-o", "short": "", "value": "datei", "group": "image", "help": "Ausgabedatei des Images.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": true },
        { "flag": "--name", "short": "", "value": "name", "group": "image", "help": "Name der Diskette im Verzeichniskopf.", "choices": [], "default": "VINTAGECODER", "default_text": "", "repeat": false, "required": false },
        { "flag": "--id", "short": "", "value": "id", "group": "image", "help": "Disketten-ID im Verzeichniskopf.", "choices": [], "default": "VC", "default_text": "", "repeat": false, "required": false },
        { "flag": "--add", "short": "", "value": "datei[:NAME]", "group": "image", "help": "Programmdatei (PRG) auf die Diskette schreiben, optional unter anderem Namen.", "choices": [], "default": "", "default_text": "Dateiname ohne Endung, in Großbuchstaben", "repeat": true, "required": false },
        { "flag": "--keep", "short": "", "value": "", "group": "allgemein", "help": "Wird angenommen und ignoriert.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": false },
        { "flag": "--data-dir", "short": "", "value": "pfad", "group": "allgemein", "help": "Ordner der Hardware-Datenbank; sonst VC_DATA oder neben dem Programm.", "choices": [], "default": "", "default_text": "", "repeat": false, "required": false }
      ],
      "examples": [
        { "title": "Diskette mit einem Programm", "cmd": "vcc disk d64 -o spiel.d64 --name SPIEL --id 01 --add jumprun.prg:JUMPRUN" }
      ],
      "notes": ["Die Ausgabe zeigt Größe und freie Blöcke."],
      "see_also": ["import", "build"]
    },
    {
      "id": "d71",
      "usage": "vcc disk d71 -o <out.d71> [--name <name>] [--id <id>] [--add <datei[:NAME]>]...",
      "summary": "D71-Image (1571) mit Programmen anlegen",
      "args": [],
      "option_groups": [ { "id": "image", "label": "Image" }, { "id": "allgemein", "label": "Allgemein" } ],
