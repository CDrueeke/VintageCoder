        },
        {
          "flag": "--asm",
          "short": "",
          "value": "",
          "group": "umwandlung",
          "help": "Also creates a disassembled source file (.asm) for machine programs. This is purely mechanical: data appears as instructions.",
          "choices": [],
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--cpu",
          "short": "",
          "value": "id",
          "group": "umwandlung",
          "help": "Processor for disassembling with --asm (name of a file in data/cpus).",
          "choices": [],
          "default": "",
          "default_text": "6510, or sally for Atari programs",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--raw",
          "short": "",
          "value": "",
          "group": "umwandlung",
          "help": "Also keeps the unchanged original file when a BASIC program is imported as source text.",
          "choices": [],
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--no-basic",
          "short": "",
          "value": "",
          "group": "umwandlung",
          "help": "Does not detect BASIC and copies the files unchanged.",
          "choices": [],
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "path",
          "group": "allgemein",
          "help": "Folder of the hardware database. Otherwise VC_DATA or next to the program.",
          "choices": [],
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "Atari program with source text",
          "cmd": "vcc import jumprun.xex --asm --into myproject"
        },
        {
          "title": "Import a BASIC program",
          "cmd": "vcc import stars.prg --into myproject"
        }
      ],
      "notes": [
        "A file counts as an Atari program if it has an XEX signature or is a tokenized Atari BASIC file (.bas). It also counts as a program if it has the extension .prg."
      ],
      "see_also": [
