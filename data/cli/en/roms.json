    {
      "id": "import",
      "usage": "vcc roms import <file|folder> ... [optionen]",
      "summary": "copy recognized ROMs to the ROM folder",
      "args": [
        {
          "name": "file|folder",
          "required": true,
          "repeat": true,
          "help": "Files or folders with ROM images. Not needed with --from-others."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Search"
        },
        {
          "id": "import",
          "label": "Import"
        }
      ],
      "options": [
        {
          "flag": "--system",
          "short": "",
          "value": "system",
          "group": "import",
          "help": "Assigns the files to this system instead of recognizing it.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--from-others",
          "short": "",
          "value": "",
          "group": "import",
          "help": "Takes matching ROMs from the folders of other programs instead of from files.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--yes",
          "short": "",
          "value": "",
          "group": "import",
          "help": "Really copies. Without --yes, the command only shows a preview.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Also search the ROM folders of other programs.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Project folder to search for ROMs first.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Folder of the hardware database.",
          "default": "",
          "default_text": "VC_DATA, otherwise next to the program or in the working folder",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "Preview for a folder",
          "cmd": "vcc roms import ~/Downloads/c64roms"
        },
        {
          "title": "Take ROMs of other programs",
          "cmd": "vcc roms import --from-others --yes"
        }
      ],
      "notes": [
        "Without --yes, nothing is copied."
      ],
      "exit": {
        "0": "preview printed, or files copied",
        "1": "copying failed",
        "2": "no files given"
      },
      "see_also": []
    },
    {
      "id": "emit-known",
      "usage": "vcc roms emit-known [optionen]",
      "summary": "create entries for data/roms/known.json from real files",
      "args": [],
      "option_groups": [
        {
          "id": "tabelle",
          "label": "Table"
        },
        {
          "id": "eintrag",
          "label": "Entry (after --file)"
        }
      ],
      "options": [
        {
          "flag": "--into",
          "short": "",
          "value": "file.json",
          "group": "tabelle",
          "help": "Writes to this table (read and extended if it exists). Without it, output goes to stdout.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--vice",
          "short": "",
          "value": "folder",
          "group": "tabelle",
          "help": "Takes the ROMs from a VICE data folder.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--merge-json",
          "short": "",
          "value": "file.json",
          "group": "tabelle",
          "help": "Adds entries from a JSON list in the format of known.json.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--file",
          "short": "",
          "value": "file",
          "group": "eintrag",
          "help": "Starts an entry for this ROM file. The options that follow belong to it.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--as",
          "short": "",
          "value": "system/role",
          "group": "eintrag",
          "help": "System and role of the entry.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--rev",
          "short": "",
          "value": "rev",
          "group": "eintrag",
          "help": "Revision of the entry.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--free",
          "short": "",
          "value": "",
          "group": "eintrag",
          "help": "Marks the ROM as free (replacement ROM).",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--default",
          "short": "",
          "value": "",
          "group": "eintrag",
          "help": "Marks the revision as the default of the role.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--note",
          "short": "",
          "value": "text",
          "group": "eintrag",
          "help": "Note for the entry.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--set",
          "short": "",
          "value": "name:offset:size:profile[:text]",
          "group": "eintrag",
          "help": "Names a range of the ROM (offset, size, profile).",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "From VICE data into a table",
          "cmd": "vcc roms emit-known --vice /usr/lib/vice --into known.json"
        },
        {
          "title": "Add one file",
          "cmd": "vcc roms emit-known --file kernal.bin --as c64/kernal --rev 901227-03 --into known.json"
        }
      ],
      "notes": [
        "Tool for maintaining the database. --as, --rev, --free, --default, --note and --set apply to the --file before them. --as is required for each --file."
      ],
      "exit": {
        "0": "table printed or written",
        "1": "at least one entry failed",
        "2": "option without a preceding --file, or unknown option"
      },
      "see_also": []
    }
  ]
}
