          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Project folder to search for ROMs first.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
