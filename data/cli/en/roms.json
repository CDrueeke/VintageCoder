{
  "i18n": { "status": "maschinell", "source_hash": "98ef81b9e8ce" },
  "command": "roms",
  "group": "daten",
  "summary": "Show, check and import ROM files",
  "description": [
    "Manages the ROM images that emulators and checks need. The systems are c64, c128, vic20, plus4, atari8 and mega65. A role is a single ROM of a system (e.g. c64/kernal). You can replace the ROM folder with VC_ROMS."
  ],
  "aliases": [],
  "forms": [
    {
      "id": "list",
      "usage": "vcc roms list [system] [optionen]",
      "summary": "show the status per system and role",
      "args": [
        {
          "name": "system",
          "required": false,
          "repeat": false,
          "help": "Show only this system."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Search"
        }
      ],
      "options": [
        {
          "flag": "--json",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Print the list as JSON.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Also search the ROM folders of other programs.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Project folder to search for ROMs first.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Folder of the hardware database.",
          "default": "",
          "default_text": "VC_DATA, otherwise next to the program or in the working folder",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "all systems",
          "cmd": "vcc roms list"
        },
        {
          "title": "C64 only, as JSON",
          "cmd": "vcc roms list c64 --json"
        }
      ],
      "notes": [
        "A status is Recognized, Unknown revision, Replacement (free), Missing or Not usable."
      ],
      "see_also": [
        "roms"
      ]
    },
    {
      "id": "check",
      "usage": "vcc roms check [system ...] [optionen]",
      "summary": "check that the required ROMs are present",
      "args": [
        {
          "name": "system",
          "required": false,
          "repeat": true,
          "help": "Systems to check. Without it, all systems."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Search"
        }
      ],
      "options": [
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Also search the ROM folders of other programs.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Project folder to search for ROMs first.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Folder of the hardware database.",
          "default": "",
          "default_text": "VC_DATA, otherwise next to the program or in the working folder",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "Check all systems",
          "cmd": "vcc roms check"
        },
        {
          "title": "Check C64 and Atari",
          "cmd": "vcc roms check c64 atari8"
        }
      ],
      "notes": [
        "Replacement ROMs count as present. If something is missing and matching files are in other programs, the output names vcc roms import --from-others."
      ],
      "exit": {
        "0": "all required ROMs present",
        "1": "a required ROM is missing",
        "2": "unknown system"
      },
      "see_also": []
    },
    {
      "id": "path",
      "usage": "vcc roms path <system/role> [optionen]",
      "summary": "print the path of the ROM file in use",
      "args": [
        {
          "name": "system/role",
          "required": true,
          "repeat": false,
          "help": "System and role, e.g. c64/kernal."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Search"
        }
      ],
      "options": [
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Also search the ROM folders of other programs.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Project folder to search for ROMs first.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "folder",
          "group": "suche",
          "help": "Folder of the hardware database.",
          "default": "",
          "default_text": "VC_DATA, otherwise next to the program or in the working folder",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "Path of the C64 KERNAL",
          "cmd": "vcc roms path c64/kernal"
        }
      ],
      "exit": {
        "0": "path printed",
        "1": "the file is missing or not usable",
        "2": "argument is not in the form system/role"
      },
      "see_also": []
    },
    {
      "id": "where",
      "usage": "vcc roms where [optionen]",
      "summary": "show the ROM folder, search locations and portable mode",
      "args": [],
      "option_groups": [
        {
          "id": "suche",
          "label": "Search"
        }
      ],
      "options": [
        {
          "flag": "--foreign",
