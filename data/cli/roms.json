        },
        {
          "flag": "--project",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Projektordner, in dem zuerst nach ROMs gesucht wird.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Ordner der Hardware-Datenbank.",
          "default": "",
          "default_text": "VC_DATA, sonst neben dem Programm oder im Arbeitsordner",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "Suchorte anzeigen",
          "cmd": "vcc roms where"
        },
        {
          "title": "mit ROMs anderer Programme",
          "cmd": "vcc roms where --foreign"
        }
      ],
      "notes": [
        "Zeigt Schreibziel, Benutzerordner, portablen Modus, Zwischenspeicher und die gesuchten Orte in der Reihenfolge der Suche."
      ],
      "see_also": []
    },
    {
      "id": "import",
      "usage": "vcc roms import <datei|ordner> ... [optionen]",
      "summary": "erkannte ROMs in den ROM-Ordner kopieren",
      "args": [
        {
          "name": "datei|ordner",
          "required": true,
          "repeat": true,
          "help": "Dateien oder Ordner mit ROM-Abbildern; entfällt bei --from-others."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Suche"
        },
        {
          "id": "import",
          "label": "Import"
        }
      ],
      "options": [
        {
          "flag": "--system",
          "short": "",
          "value": "system",
          "group": "import",
          "help": "Ordnet die Dateien diesem System zu, statt es zu erkennen.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--from-others",
          "short": "",
          "value": "",
          "group": "import",
          "help": "Übernimmt passende ROMs aus Ordnern anderer Programme statt aus Dateien.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--yes",
          "short": "",
          "value": "",
          "group": "import",
          "help": "Kopiert wirklich; ohne --yes zeigt der Befehl nur die Vorschau.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Sucht auch in ROM-Ordnern anderer Programme.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Projektordner, in dem zuerst nach ROMs gesucht wird.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Ordner der Hardware-Datenbank.",
          "default": "",
          "default_text": "VC_DATA, sonst neben dem Programm oder im Arbeitsordner",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "Vorschau für einen Ordner",
          "cmd": "vcc roms import ~/Downloads/c64roms"
        },
        {
          "title": "ROMs anderer Programme übernehmen",
          "cmd": "vcc roms import --from-others --yes"
        }
      ],
      "notes": [
        "Ohne --yes wird nichts kopiert."
      ],
      "exit": {
        "0": "Vorschau ausgegeben oder kopiert",
        "1": "Kopieren fehlgeschlagen",
        "2": "keine Dateien angegeben"
      },
      "see_also": []
    },
    {
      "id": "emit-known",
      "usage": "vcc roms emit-known [optionen]",
      "summary": "Einträge für data/roms/known.json aus echten Dateien erzeugen",
      "args": [],
      "option_groups": [
        {
          "id": "tabelle",
          "label": "Tabelle"
        },
        {
          "id": "eintrag",
          "label": "Eintrag (hinter --file)"
        }
      ],
      "options": [
        {
          "flag": "--into",
          "short": "",
          "value": "datei.json",
          "group": "tabelle",
          "help": "Schreibt in diese Tabelle (wird gelesen und ergänzt, falls sie existiert); ohne Angabe nach stdout.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--vice",
          "short": "",
          "value": "ordner",
          "group": "tabelle",
          "help": "Übernimmt die ROMs aus einem VICE-Datenordner.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--merge-json",
          "short": "",
          "value": "datei.json",
          "group": "tabelle",
          "help": "Fügt Einträge aus einer JSON-Liste im Format von known.json hinzu.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--file",
          "short": "",
          "value": "datei",
          "group": "eintrag",
          "help": "Beginnt einen Eintrag für diese ROM-Datei; die folgenden Optionen gehören dazu.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--as",
          "short": "",
          "value": "system/rolle",
          "group": "eintrag",
          "help": "System und Rolle des Eintrags.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--rev",
          "short": "",
          "value": "rev",
          "group": "eintrag",
          "help": "Revision des Eintrags.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--free",
          "short": "",
          "value": "",
          "group": "eintrag",
          "help": "Markiert die ROM als frei (Ersatz-ROM).",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--default",
          "short": "",
          "value": "",
          "group": "eintrag",
          "help": "Markiert die Revision als Standard der Rolle.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--note",
          "short": "",
          "value": "text",
          "group": "eintrag",
          "help": "Anmerkung zum Eintrag.",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        },
        {
          "flag": "--set",
          "short": "",
          "value": "name:offset:size:profile[:text]",
          "group": "eintrag",
          "help": "Benennt einen Bereich der ROM (Offset, Größe, Profil).",
          "default": "",
          "default_text": "",
          "repeat": true,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "aus VICE-Daten in eine Tabelle",
          "cmd": "vcc roms emit-known --vice /usr/lib/vice --into known.json"
        },
        {
          "title": "eine Datei eintragen",
          "cmd": "vcc roms emit-known --file kernal.bin --as c64/kernal --rev 901227-03 --into known.json"
        }
      ],
      "notes": [
        "Werkzeug für die Pflege der Datenbank. --as, --rev, --free, --default, --note und --set gelten für das davor stehende --file; --as ist je --file Pflicht."
      ],
      "exit": {
        "0": "Tabelle ausgegeben oder geschrieben",
        "1": "mindestens ein Eintrag fehlgeschlagen",
        "2": "Option ohne vorangehendes --file oder unbekannte Option"
      },
      "see_also": []
    }
  ]
}
