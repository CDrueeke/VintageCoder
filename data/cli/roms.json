{
  "command": "roms",
  "group": "daten",
  "summary": "ROM-Dateien anzeigen, prüfen und importieren",
  "description": [
    "Verwaltet die ROM-Abbilder, die Emulatoren und Prüfungen brauchen. Systeme sind c64, c128, vic20, plus4, atari8 und mega65; eine Rolle ist eine einzelne ROM eines Systems (z. B. c64/kernal). Der ROM-Ordner lässt sich mit VC_ROMS ersetzen."
  ],
  "aliases": [],
  "forms": [
    {
      "id": "list",
      "usage": "vcc roms list [system] [optionen]",
      "summary": "Status je System und Rolle anzeigen",
      "args": [
        {
          "name": "system",
          "required": false,
          "repeat": false,
          "help": "Nur dieses System anzeigen."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Suche"
        }
      ],
      "options": [
        {
          "flag": "--json",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Gibt die Liste als JSON aus.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Sucht auch in ROM-Ordnern anderer Programme.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Projektordner, in dem zuerst nach ROMs gesucht wird.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Ordner der Hardware-Datenbank.",
          "default": "",
          "default_text": "VC_DATA, sonst neben dem Programm oder im Arbeitsordner",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "alle Systeme",
          "cmd": "vcc roms list"
        },
        {
          "title": "nur C64 als JSON",
          "cmd": "vcc roms list c64 --json"
        }
      ],
      "notes": [
        "Ein Status ist Erkannt, Unbekannte Revision, Ersatz (frei), Fehlt oder Nicht benutzbar."
      ],
      "see_also": [
        "roms"
      ]
    },
    {
      "id": "check",
      "usage": "vcc roms check [system ...] [optionen]",
      "summary": "prüfen, ob die erforderlichen ROMs vorhanden sind",
      "args": [
        {
          "name": "system",
          "required": false,
          "repeat": true,
          "help": "Zu prüfende Systeme; ohne Angabe alle."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Suche"
        }
      ],
      "options": [
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Sucht auch in ROM-Ordnern anderer Programme.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Projektordner, in dem zuerst nach ROMs gesucht wird.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Ordner der Hardware-Datenbank.",
          "default": "",
          "default_text": "VC_DATA, sonst neben dem Programm oder im Arbeitsordner",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "alle Systeme prüfen",
          "cmd": "vcc roms check"
        },
        {
          "title": "C64 und Atari prüfen",
          "cmd": "vcc roms check c64 atari8"
        }
      ],
      "notes": [
        "Ersatz-ROMs gelten als vorhanden. Fehlt etwas und liegen passende Dateien in anderen Programmen, nennt die Ausgabe vcc roms import --from-others."
      ],
      "exit": {
        "0": "alle erforderlichen ROMs vorhanden",
        "1": "eine erforderliche ROM fehlt",
        "2": "unbekanntes System"
      },
      "see_also": []
    },
    {
      "id": "path",
      "usage": "vcc roms path <system/rolle> [optionen]",
      "summary": "Pfad der benutzten ROM-Datei ausgeben",
      "args": [
        {
          "name": "system/rolle",
          "required": true,
          "repeat": false,
          "help": "System und Rolle, z. B. c64/kernal."
        }
      ],
      "option_groups": [
        {
          "id": "suche",
          "label": "Suche"
        }
      ],
      "options": [
        {
          "flag": "--foreign",
          "short": "",
          "value": "",
          "group": "suche",
          "help": "Sucht auch in ROM-Ordnern anderer Programme.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--project",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Projektordner, in dem zuerst nach ROMs gesucht wird.",
          "default": "",
          "default_text": "",
          "repeat": false,
          "required": false
        },
        {
          "flag": "--data-dir",
          "short": "",
          "value": "ordner",
          "group": "suche",
          "help": "Ordner der Hardware-Datenbank.",
          "default": "",
          "default_text": "VC_DATA, sonst neben dem Programm oder im Arbeitsordner",
          "repeat": false,
          "required": false
        }
      ],
      "examples": [
        {
          "title": "Pfad des C64-KERNAL",
          "cmd": "vcc roms path c64/kernal"
        }
      ],
      "exit": {
        "0": "Pfad ausgegeben",
        "1": "die Datei fehlt oder ist nicht benutzbar",
        "2": "Angabe nicht in der Form system/rolle"
      },
      "see_also": []
    },
    {
      "id": "where",
      "usage": "vcc roms where [optionen]",
      "summary": "ROM-Ordner, Suchorte und portablen Modus anzeigen",
      "args": [],
      "option_groups": [
        {
          "id": "suche",
          "label": "Suche"
        }
      ],
      "options": [
        {
          "flag": "--foreign",
