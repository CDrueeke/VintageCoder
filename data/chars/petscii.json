{
  "_comment": "Steuerzeichen von PETSCII (C64, C128, Plus/4, C16, VC-20, MEGA65): eine Namensquelle fuer Assembler, BASIC und Zeichen-Panel. name = Hauptname im Assembler, basic = Hauptname im BASIC (fehlt: wie name), aliases = weitere Schreibweisen; alle Namen gelten in beiden Sprachen (klein, _ und - wie Leerzeichen). group: color, cursor, edit, charset, fkey, other. color = Farbnummer 0..15 (C64-Reihenfolge).",
  "entries": [
    {"code": "$03", "name": "stop", "group": "other", "desc": "STOP-Taste"},
    {"code": "$05", "name": "wht", "group": "color", "color": 1, "desc": "Weiß"},
    {"code": "$0d", "name": "ret", "basic": "return", "group": "other", "desc": "Wagenrücklauf (RETURN)"},
    {"code": "$0e", "name": "lower", "group": "charset", "desc": "Klein-/Großschrift einschalten"},
    {"code": "$11", "name": "down", "group": "cursor", "desc": "Cursor runter"},
    {"code": "$12", "name": "rvs on", "aliases": ["rvon"], "group": "edit", "desc": "Invers an"},
    {"code": "$13", "name": "home", "group": "cursor", "desc": "Cursor links oben"},
    {"code": "$14", "name": "del", "group": "edit", "desc": "Zeichen links löschen"},
    {"code": "$1c", "name": "red", "group": "color", "color": 2, "desc": "Rot"},
    {"code": "$1d", "name": "right", "basic": "rght", "group": "cursor", "desc": "Cursor rechts"},
    {"code": "$1e", "name": "grn", "group": "color", "color": 5, "desc": "Grün"},
    {"code": "$1f", "name": "blu", "group": "color", "color": 6, "desc": "Blau"},
    {"code": "$20", "name": "space", "group": "other", "desc": "Leerzeichen"},
    {"code": "$5c", "name": "pound", "group": "other", "desc": "Pfund-Zeichen (£)"},
    {"code": "$81", "name": "orange", "basic": "orng", "group": "color", "color": 8, "desc": "Orange"},
    {"code": "$85", "name": "f1", "group": "fkey", "desc": "F1"},
    {"code": "$86", "name": "f3", "group": "fkey", "desc": "F3"},
    {"code": "$87", "name": "f5", "group": "fkey", "desc": "F5"},
    {"code": "$88", "name": "f7", "group": "fkey", "desc": "F7"},
    {"code": "$89", "name": "f2", "group": "fkey", "desc": "F2"},
    {"code": "$8a", "name": "f4", "group": "fkey", "desc": "F4"},
    {"code": "$8b", "name": "f6", "group": "fkey", "desc": "F6"},
    {"code": "$8c", "name": "f8", "group": "fkey", "desc": "F8"},
    {"code": "$8d", "name": "shift ret", "basic": "shift return", "group": "other", "desc": "Zeilenvorschub (Umschalt+RETURN)"},
    {"code": "$8e", "name": "upper", "group": "charset", "desc": "Groß-/Grafikschrift einschalten"},
    {"code": "$90", "name": "blk", "group": "color", "color": 0, "desc": "Schwarz"},
    {"code": "$91", "name": "up", "group": "cursor", "desc": "Cursor hoch"},
    {"code": "$92", "name": "rvs off", "aliases": ["rvof"], "group": "edit", "desc": "Invers aus"},
    {"code": "$93", "name": "clr", "group": "edit", "desc": "Bildschirm löschen"},
    {"code": "$94", "name": "inst", "group": "edit", "desc": "Zeichen einfügen"},
    {"code": "$95", "name": "brn", "group": "color", "color": 9, "desc": "Braun"},
    {"code": "$96", "name": "lred", "group": "color", "color": 10, "desc": "Hellrot"},
    {"code": "$97", "name": "gry1", "group": "color", "color": 11, "desc": "Dunkelgrau"},
    {"code": "$98", "name": "gry2", "group": "color", "color": 12, "desc": "Mittelgrau"},
    {"code": "$99", "name": "lgrn", "group": "color", "color": 13, "desc": "Hellgrün"},
    {"code": "$9a", "name": "lblu", "group": "color", "color": 14, "desc": "Hellblau"},
    {"code": "$9b", "name": "gry3", "group": "color", "color": 15, "desc": "Hellgrau"},
    {"code": "$9c", "name": "pur", "group": "color", "color": 4, "desc": "Violett"},
    {"code": "$9d", "name": "left", "group": "cursor", "desc": "Cursor links"},
    {"code": "$9e", "name": "yel", "group": "color", "color": 7, "desc": "Gelb"},
    {"code": "$9f", "name": "cyn", "group": "color", "color": 3, "desc": "Türkis"},
    {"code": "$a0", "name": "shift space", "group": "other", "desc": "Umschalt+Leerzeichen"},
    {"code": "$ff", "name": "pi", "group": "other", "desc": "Pi (π)"}
  ]
}
