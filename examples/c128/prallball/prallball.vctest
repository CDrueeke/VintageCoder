   "name": "copy_font: Zeichen A (Bildschirmcode 1) aus dem Zeichen-ROM nach $8808; eigener Stein links bei $8A00",
   "setup": {
    "mem": {
     "$ff00": 62,
     "$8808": 0,
     "$8a00": 0
    }
   },
   "call": "copy_font",
   "expect": [
