    "[$8809] == $3c",
    "[$8a00] == $15",
    "[$8a01] == $1f"
   ]
  },
  {
   "name": "clear_screen: Bildschirm bei $8400 leer (32), Farb-RAM weiss",
   "setup": {
    "mem": {
     "$ff00": 62,
     "$8400": 5,
     "$87e7": 5,
     "$d800": 7,
     "$dbe7": 7
    }
   },
   "call": "clear_screen",
   "expect": [
    "[$8400] == 32",
    "[$87e7] == 32",
    "([$d800] & 15) == 1",
    "([$dbe7] & 15) == 1"
   ]
  },
  {
   "name": "put_cell: Zeichen A mit Farbe an Spalte 3, Zeile 2 (Bildschirm $8400, Farb-RAM $D800)",
   "setup": {
    "mem": {
     "$ff00": 62,
     "$33": 7
    },
    "a": "1",
    "x": 3,
    "y": 2
   },
   "call": "put_cell",
   "expect": [
    "[$8400 + 2 * 40 + 3] == 1",
    "([$d800 + 2 * 40 + 3] & 15) == 7"
   ]
  },
  {
   "name": "vic_init: VIC-Bank 2 (CIA2 Bits 0-1 = 01), Bildschirm $8400 / Zeichensatz $8800 ($D018 = $12), 1 MHz",
   "setup": {
    "mem": {
     "$ff00": 62,
     "$d030": 1
    }
   },
   "call": "vic_init",
   "expect": [
    "([$dd00] & 3) == 1",
    "([$d018] & $fe) == $12",
    "([$d030] & 1) == 0",
    "([$ffff] * 256 + [$fffe]) == irq"
   ]
  },
