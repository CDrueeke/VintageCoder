   "expect": [
    "[$e008] == $18",
    "[$e009] == $3c",
    "[$e200] == $7f",
    "[$e207] == 0",
    "[$e000 + 127 * 8] == $ff"
   ]
  },
  {
   "name": "clear_screen: Spiegel und Schattenkopien leer (32), Attribute weiss (15)",
   "setup": {
    "mem": {
     "$ff00": 62,
     "$b000": 5,
     "$b3e7": 5,
     "$b400": 5,
     "$ac00": 7,
     "$afe7": 7,
     "$b800": 7
    }
   },
   "call": "clear_screen",
   "expect": [
    "[$b000] == 32",
    "[$b3e7] == 32",
    "[$b400] == 32",
    "[$b7e7] == 32",
    "[$ac00] == 15",
    "[$afe7] == 15",
    "[$b800] == 15",
    "[$bbe7] == 15",
    "[pool_n] == 0"
   ]
  },
  {
   "name": "VDC nach clear_screen: Bildschirm (Zelle 0) = 32",
   "setup": {
    "a": "0",
    "y": "0",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == 32"
   ]
  },
  {
   "name": "VDC nach clear_screen: letzte Zelle des Bildschirms ($07CF) = 32",
   "setup": {
    "a": "7",
    "y": "$cf",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == 32"
   ]
  },
  {
   "name": "VDC nach clear_screen: Attribut links (Zelle 0, $0800) = 15",
   "setup": {
    "a": "8",
    "y": "0",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == 15"
   ]
  },
  {
   "name": "VDC nach clear_screen: Attribut rechts (Zelle 1, $0801) = 15 mit Bit 7",
   "setup": {
    "a": "8",
    "y": "1",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == $8f"
   ]
  },
  {
   "name": "put_cell: Zeichen A (1) mit Farbe 7 (gelb) an Spalte 3, Zeile 2: Spiegel, Schattenkopie, Attribut 13",
   "setup": {
    "mem": {
     "$ff00": 62,
     "$33": 7
    },
    "a": "1",
    "x": 3,
    "y": 2
   },
   "call": "put_cell",
   "expect": [
    "[$b000 + 2 * 40 + 3] == 1",
    "[$b400 + 2 * 40 + 3] == 1",
    "[$ac00 + 2 * 40 + 3] == 13",
    "[$b800 + 2 * 40 + 3] == 13"
   ]
  },
  {
   "name": "VDC nach put_cell: linke Zelle (Zeile 2, Spalte 3) = Zeichen 1",
   "setup": {
    "a": "0",
    "y": "$a6",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == 1"
   ]
  },
  {
   "name": "VDC nach put_cell: rechte Zelle = Zeichen 1",
   "setup": {
    "a": "0",
    "y": "$a7",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == 1"
   ]
  },
  {
   "name": "VDC nach put_cell: Attribut links = 13",
   "setup": {
    "a": "8",
    "y": "$a6",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == 13"
   ]
  },
  {
   "name": "VDC nach put_cell: Attribut rechts = 13 mit Bit 7",
   "setup": {
    "a": "8",
    "y": "$a7",
    "mem": {
     "$ff00": 62
    }
   },
   "call": "vdc_get",
   "expect": [
    "a == $8d"
   ]
  },
  {
   "name": "draw_brick: Typ 3 an Spalte 1, Zeile 0 -> Zeichen 64/65 in Zeile 4, Spalte 4/5 (Attribut 5 = gruen)",
   "setup": {
    "mem": {
     "$ff00": 62,
     "$28": 1,
     "$29": 0
    },
