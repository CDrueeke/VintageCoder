{
 "kind": "test",
 "target": "mega65",
 "program": "build/tiles_demo_3x2_ptr.prg",
 "trap": "$1f00",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$02-$21"
  },
  {
   "check": "cycles",
   "label": "tile_put",
   "max": 190,
   "level": "error"
  }
 ],
 "tests": [
  {
   "name": "screen_draw 1: Bildschirm und Farb-RAM = Referenz",
   "call": "t_screen1",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw 1: Stichproben links oben / rechts unten",
   "call": "t_screen1_nocheck",
   "expect": [
    "[$0800] == 31",
    "([$d800] & 15) == 5",
    "[$0801] == 34",
    "([$d801] & 15) == 5",
    "[$0802] == 37",
    "([$d802] & 15) == 5",
    "[$0828] == 40",
    "([$d828] & 15) == 5",
    "[$0829] == 43",
    "([$d829] & 15) == 5",
    "[$082a] == 46",
    "([$d82a] & 15) == 5",
    "[$0af1] == 45",
    "([$daf1] & 15) == 13",
    "[$0af2] == 48",
    "([$daf2] & 15) == 13",
    "[$0af3] == 51",
    "([$daf3] & 15) == 13",
    "[$0b19] == 54",
    "([$db19] & 15) == 13",
    "[$0b1a] == 57",
    "([$db1a] & 15) == 13",
    "[$0b1b] == 60",
    "([$db1b] & 15) == 13"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw_rows 3..5 von Screen 2: nur diese Zeilen (Referenz)",
   "call": "t_rows",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_draw, tile_draw_color, tile_fill (Referenz)",
   "call": "t_macros",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put dreimal (Referenz)",
   "call": "t_puts",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put: Kachel 5 nach (2,3)",
   "setup": {
    "a": "5",
    "x": 2,
    "y": 3
   },
   "call": "tile_put",
   "expect": [
    "[$08f6] == 52",
    "([$d8f6] & 15) == 14",
    "[$08f7] == 55",
    "([$d8f7] & 15) == 14",
    "[$08f8] == 58",
    "([$d8f8] & 15) == 14",
    "[$091e] == 61",
    "([$d91e] & 15) == 14",
    "[$091f] == 64",
    "([$d91f] & 15) == 14",
    "[$0920] == 67",
    "([$d920] & 15) == 14"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 0 nach (11,9)",
   "setup": {
    "a": "0",
    "x": 11,
    "y": 9
   },
   "call": "tile_put",
   "expect": [
    "[$0af1] == 17",
    "([$daf1] & 15) == 1",
    "[$0af2] == 20",
    "([$daf2] & 15) == 1",
    "[$0af3] == 23",
    "([$daf3] & 15) == 1",
    "[$0b19] == 26",
    "([$db19] & 15) == 1",
    "[$0b1a] == 29",
    "([$db1a] & 15) == 1",
    "[$0b1b] == 32",
    "([$db1b] & 15) == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 3 nach (0,0)",
   "setup": {
    "a": "3",
    "x": 0,
    "y": 0
   },
   "call": "tile_put",
   "expect": [
    "[$0800] == 38",
    "([$d800] & 15) == 15",
    "[$0801] == 41",
    "([$d801] & 15) == 15",
    "[$0802] == 44",
    "([$d802] & 15) == 15",
    "[$0828] == 47",
    "([$d828] & 15) == 15",
    "[$0829] == 50",
    "([$d829] & 15) == 15",
    "[$082a] == 53",
    "([$d82a] & 15) == 15"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (0,0) von Screen 1 = 2",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_map_get",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (0,0) von Screen 1 = 1",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (11,9) von Screen 1 = 4",
   "setup": {
    "x": 11,
    "y": 9
   },
   "call": "t_map_get",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (11,9) von Screen 1 = 4",
   "setup": {
    "x": 11,
    "y": 9
   },
   "call": "t_prop",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (3,4) von Screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_map_get",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (3,4) von Screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  }
 ]
}
