{
 "kind": "test",
 "target": "mega65",
 "program": "build/tiles_demo_2x2_ptr.prg",
 "trap": "$1f00",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$02-$21"
  },
  {
   "check": "cycles",
   "label": "tile_put",
   "max": 150,
   "level": "error"
  }
 ],
 "tests": [
  {
   "name": "screen_draw 1: Bildschirm und Farb-RAM = Referenz",
   "call": "t_screen1",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw 1: Stichproben links oben / rechts unten",
   "call": "t_screen1_nocheck",
   "expect": [
    "[$0800] == 31",
    "([$d800] & 15) == 5",
    "[$0801] == 34",
    "([$d801] & 15) == 5",
    "[$0828] == 37",
    "([$d828] & 15) == 5",
    "[$0829] == 40",
    "([$d829] & 15) == 5",
    "[$0aec] == 24",
    "([$daec] & 15) == 2",
    "[$0aed] == 27",
    "([$daed] & 15) == 2",
    "[$0b14] == 30",
    "([$db14] & 15) == 2",
    "[$0b15] == 33",
    "([$db15] & 15) == 2"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw_rows 3..5 von Screen 2: nur diese Zeilen (Referenz)",
   "call": "t_rows",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_draw, tile_draw_color, tile_fill (Referenz)",
   "call": "t_macros",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put dreimal (Referenz)",
   "call": "t_puts",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put: Kachel 5 nach (2,3)",
   "setup": {
    "a": "5",
    "x": 2,
    "y": 3
   },
   "call": "tile_put",
   "expect": [
    "[$08f4] == 52",
    "([$d8f4] & 15) == 14",
    "[$08f5] == 55",
    "([$d8f5] & 15) == 14",
    "[$091c] == 58",
    "([$d91c] & 15) == 14",
    "[$091d] == 61",
    "([$d91d] & 15) == 14"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 0 nach (14,9)",
   "setup": {
    "a": "0",
    "x": 14,
    "y": 9
   },
   "call": "tile_put",
   "expect": [
    "[$0aec] == 17",
    "([$daec] & 15) == 1",
    "[$0aed] == 20",
    "([$daed] & 15) == 1",
    "[$0b14] == 23",
    "([$db14] & 15) == 1",
    "[$0b15] == 26",
    "([$db15] & 15) == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 3 nach (0,0)",
   "setup": {
    "a": "3",
    "x": 0,
    "y": 0
   },
   "call": "tile_put",
   "expect": [
    "[$0800] == 38",
    "([$d800] & 15) == 15",
    "[$0801] == 41",
    "([$d801] & 15) == 15",
    "[$0828] == 44",
    "([$d828] & 15) == 15",
    "[$0829] == 47",
    "([$d829] & 15) == 15"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (0,0) von Screen 1 = 2",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_map_get",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (0,0) von Screen 1 = 1",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (14,9) von Screen 1 = 1",
   "setup": {
    "x": 14,
    "y": 9
   },
   "call": "t_map_get",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (14,9) von Screen 1 = 1",
   "setup": {
    "x": 14,
    "y": 9
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (3,4) von Screen 1 = 2",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_map_get",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (3,4) von Screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  }
 ]
}
