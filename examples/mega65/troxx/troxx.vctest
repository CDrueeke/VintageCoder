{
 "kind": "test",
 "target": "mega65",
 "program": "build/main.prg",
 "trap": "$1f00",
 "static": [
  {
   "check": "size",
   "segment": "PROGRAM",
   "max": 40000,
   "maxEnd": "$b800",
   "name": "Programm endet vor den Sprite-Daten ($B800)"
  },
  {
   "check": "overlap"
  },
  {
   "check": "expr",
   "name": "Schattengitter passt vor die Spielvariablen: CELL + 43 * 80 <= BOXCNT",
   "expr": "$c000 + 43 * 80 <= $ce00"
  },
  {
   "check": "expr",
   "name": "Gesichertes Gitter passt in $1000 Byte",
   "expr": "$cd6f - $c000 + 98 + 3 <= $1000"
  }
 ],
 "tests": [
  {
   "name": "Vorbereitung: ROMs ausblenden (Xemu-Start mit ROM-BASIC ueber $2000)",
   "setup": {
    "mem": {
     "$1f40": [
      169,
      0,
      141,
      48,
      208,
      170,
      168,
      75,
      92,
      234,
      96
     ]
    }
   },
   "call": "$1f40",
   "expect": [
    "[$1f40] == $a9"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "rnd: Startwert 1 -> $B8 (LSR, Uebertrag, EOR $B8)",
   "setup": {
    "mem": {
     "$6": 1
    }
   },
   "call": "enemies.rnd",
   "expect": [
    "a == $b8",
    "[$6] == $b8"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "rnd: gerader Startwert $B8 -> $5C (nur LSR)",
   "setup": {
    "mem": {
     "$6": 184
    }
   },
   "call": "enemies.rnd",
   "expect": [
    "a == $5c"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "level_idx: Stufe 1 -> Index 0",
   "setup": {
    "mem": {
     "$b": 1
    }
   },
   "call": "enemies.level_idx",
   "expect": [
    "y == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "level_idx: Stufe 9 -> Index 8",
   "setup": {
    "mem": {
     "$b": 9
    }
   },
   "call": "enemies.level_idx",
   "expect": [
    "y == 8"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "level_idx: Stufe 12 (BCD $12) gilt wie 9",
   "setup": {
    "mem": {
     "$b": 18
    }
   },
   "call": "enemies.level_idx",
   "expect": [
    "y == 8"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "grid.set_row: Zeile 0 -> CELL + 0",
   "setup": {
    "y": 0
   },
   "call": "grid.set_row",
   "expect": [
    "[$67] == $0",
    "[$68] == $c0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "grid.set_row: Zeile 1 -> CELL + 80",
   "setup": {
    "y": 1
   },
   "call": "grid.set_row",
   "expect": [
    "[$67] == $50",
    "[$68] == $c0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "grid.set_row: Zeile 2 -> CELL + 160",
   "setup": {
    "y": 2
   },
   "call": "grid.set_row",
   "expect": [
    "[$67] == $a0",
    "[$68] == $c0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "grid.set_row: Zeile 42 -> CELL + 3360",
   "setup": {
    "y": 42
   },
   "call": "grid.set_row",
   "expect": [
    "[$67] == $20",
    "[$68] == $cd"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (0, 0) Ecke -> 3",
   "setup": {
    "mem": {
     "$5d": 0,
     "$5e": 0
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 3"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (5, 6) Knoten -> 3",
   "setup": {
    "mem": {
     "$5d": 5,
     "$5e": 6
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 3"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (1, 0) waagerechte Linie oben -> 1",
   "setup": {
    "mem": {
     "$5d": 1,
     "$5e": 0
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (3, 12) waagerechte Linie -> 1",
   "setup": {
    "mem": {
     "$5d": 3,
     "$5e": 12
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (0, 1) senkrechte Linie links -> 2",
   "setup": {
    "mem": {
     "$5d": 0,
     "$5e": 1
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (70, 41) senkrechte Linie rechts -> 2",
   "setup": {
    "mem": {
     "$5d": 70,
     "$5e": 41
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (2, 3) Innenraum -> 0",
   "setup": {
    "mem": {
     "$5d": 2,
     "$5e": 3
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type: (68, 40) Innenraum unten rechts -> 0",
   "setup": {
    "mem": {
     "$5d": 68,
     "$5e": 40
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes: (1, 6) waagerecht, Rechteck (0,1) unten und (0,0) oben: 14 und 0",
   "setup": {
    "mem": {
     "$5d": 1,
     "$5e": 6,
     "$5f": 1
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$71] == 14",
    "[$72] == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes: (1, 0) waagerecht am oberen Rand: nur unten (0)",
   "setup": {
    "mem": {
     "$5d": 1,
     "$5e": 0,
     "$5f": 1
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$71] == 0",
    "[$72] == 255"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes: (1, 42) waagerecht am unteren Rand: nur oben (84 = 14 * 6)",
   "setup": {
    "mem": {
     "$5d": 1,
     "$5e": 42,
     "$5f": 1
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$71] == 255",
    "[$72] == 84"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes: (5, 1) senkrecht, Rechteck (1,0) rechts und (0,0) links",
   "setup": {
    "mem": {
     "$5d": 5,
     "$5e": 1,
     "$5f": 2
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$71] == 1",
    "[$72] == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes: (0, 1) senkrecht am linken Rand: nur rechts",
   "setup": {
    "mem": {
     "$5d": 0,
     "$5e": 1,
     "$5f": 2
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$71] == 0",
    "[$72] == 255"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes: (70, 1) senkrecht am rechten Rand: nur links (13)",
   "setup": {
    "mem": {
     "$5d": 70,
     "$5e": 1,
     "$5f": 2
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$71] == 255",
    "[$72] == 13"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "legal_mask: Knoten (5, 6), Richtung runter: hoch ausgeschlossen",
   "setup": {
    "mem": {
     "$61": 5,
     "$62": 6,
     "$63": 1
    }
   },
   "call": "grid.legal_mask",
   "expect": [
    "a == 14"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "legal_mask: Ecke (0, 0), Richtung hoch: runter ausgeschlossen = nur rechts",
   "setup": {
    "mem": {
     "$61": 0,
     "$62": 0,
     "$63": 0
    }
   },
   "call": "grid.legal_mask",
   "expect": [
    "a == 8"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "legal_mask: Ecke (0, 0), Richtung rechts: runter und rechts",
   "setup": {
    "mem": {
     "$61": 0,
     "$62": 0,
     "$63": 3
    }
   },
   "call": "grid.legal_mask",
   "expect": [
    "a == 10"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "legal_mask: Ecke (70, 42), Richtung links: hoch, links",
   "setup": {
    "mem": {
     "$61": 70,
     "$62": 42,
     "$63": 2
    }
   },
   "call": "grid.legal_mask",
   "expect": [
    "a == 5"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "legal_mask: Ecke (70, 0), Richtung hoch: nur links (runter ist die Umkehr)",
   "setup": {
    "mem": {
     "$61": 70,
     "$62": 0,
     "$63": 0
    }
   },
   "call": "grid.legal_mask",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "legal_mask: Randknoten (35, 0), Richtung rechts: links ausgeschlossen = runter, rechts",
   "setup": {
    "mem": {
     "$61": 35,
     "$62": 0,
     "$63": 3
    }
   },
   "call": "grid.legal_mask",
   "expect": [
    "a == 10"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "box_filled: BOXCNT 4 -> gefuellt",
   "setup": {
    "x": 5,
    "mem": {
     "$ce05": 4
    }
   },
   "call": "grid.box_filled",
   "expect": [
    "fc == 1"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "box_filled: BOXCNT 3 -> nicht gefuellt",
   "setup": {
    "x": 5,
    "mem": {
     "$ce05": 3
    }
   },
   "call": "grid.box_filled",
   "expect": [
    "fc == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "box_filled: $FF (kein Rechteck) -> nicht gefuellt",
   "setup": {
    "x": 255
   },
   "call": "grid.box_filled",
   "expect": [
    "fc == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "seg_is_closed: ein angrenzendes Rechteck gefuellt -> geschuetzt",
   "setup": {
    "mem": {
     "$5d": 1,
     "$5e": 6,
     "$5f": 1,
     "$ce0e": 4
    }
   },
   "call": "grid.seg_is_closed",
   "expect": [
    "fc == 1"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "seg_is_closed: kein angrenzendes Rechteck gefuellt -> nicht geschuetzt",
   "setup": {
    "mem": {
     "$5d": 1,
     "$5e": 6,
     "$5f": 1,
     "$ce0e": 3,
     "$ce00": 3
    }
   },
   "call": "grid.seg_is_closed",
   "expect": [
    "fc == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "bcd_add: Uebertrag ueber alle Stellen",
   "setup": {
    "a": 153,
    "x": 0,
    "mem": {
     "$9": 0,
     "$29": [
      1,
      0,
      0
     ],
     "$31": 3
    }
   },
   "call": "hud.bcd_add",
   "expect": [
    "[$29] == 0",
    "[$2a] == 1",
    "[$31] == 3"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "bcd_add: Extraleben bei 10000 Punkten",
   "setup": {
    "a": 80,
    "x": 0,
    "mem": {
     "$9": 0,
     "$29": [
      80,
      153,
      9
     ],
     "$31": 3
    }
   },
   "call": "hud.bcd_add",
   "expect": [
    "[$29] == 0",
    "[$2a] == 0",
    "[$2b] == $10",
    "[$31] == 4"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "bcd_add: Leben hoechstens 9",
   "setup": {
    "a": 80,
    "x": 0,
    "mem": {
     "$9": 0,
     "$29": [
      80,
      153,
      9
     ],
     "$31": 9
    }
   },
   "call": "hud.bcd_add",
   "expect": [
    "[$31] == 9"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "bcd_add: 500 Punkte (X = 1)",
   "setup": {
    "a": 5,
    "x": 1,
    "mem": {
     "$9": 0,
     "$29": [
      32,
      1,
      0
     ],
     "$31": 3
    }
   },
   "call": "hud.bcd_add",
   "expect": [
    "[$29] == $20",
    "[$2a] == $06"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "bcd_add: Spieler 2 bucht in SCORE + 4, Leben von Spieler 2",
   "setup": {
    "a": 80,
    "x": 0,
    "mem": {
     "$9": 1,
     "$29": [
      1,
      2,
      3
     ],
     "$2d": [
      80,
      153,
      9
     ],
     "$31": [
      3,
      3
     ]
    }
   },
   "call": "hud.bcd_add",
   "expect": [
    "[$29] == 1",
    "[$2d] == 0",
    "[$2f] == $10",
    "[$31] == 3",
    "[$32] == 4"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "bcd_sub: 25 von 100 -> 75",
   "setup": {
    "a": 37,
    "mem": {
     "$9": 0,
     "$29": [
      0,
      1,
      0
     ]
    }
   },
   "call": "hud.bcd_sub",
   "expect": [
    "[$29] == $75",
    "[$2a] == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "bcd_sub: nie unter 0",
   "setup": {
    "a": 80,
    "mem": {
     "$9": 0,
     "$29": [
      32,
      0,
      0
     ]
    }
   },
   "call": "hud.bcd_sub",
   "expect": [
    "[$29] == 0",
    "[$2a] == 0",
    "[$2b] == 0"
   ],
   "timeoutMs": 20000
  },
  {
