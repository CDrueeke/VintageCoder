   ],
   "timeoutMs": 20000
  },
  {
   "name": "player.step: von (0, 42) hoch nach (0, 41): faerbt, 1 Punkt, Zelle vor dem Schritt gemerkt",
   "setup": {
    "mem": {
     "$14": 0,
     "$9": 0,
     "$15": [
      0,
      0
     ],
     "$17": [
      42,
      0
     ],
     "$1b": [
      1,
      0
     ],
     "$1f": [
      0,
      0
     ],
     "$25": [
      1,
      0
     ],
     "$27": [
      0,
      0
     ],
     "$e": 1,
     "$f": 6,
     "$36": [
      70,
      0,
      0,
      0,
      70,
      0
     ],
