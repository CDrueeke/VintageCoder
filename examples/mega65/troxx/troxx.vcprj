{
  "format": 1,
  "project": {
    "name": "MEGA65: Troxx",
    "description": "Troxx fuer den MEGA65 (VIC-IV): 80 x 50 Zeichen mit Vollfarb-Kacheln, 256-Farben-Palette, 16-Farben-Sprites, Fuellanimation per DMA, 40 MHz, mehrere SID, ein oder zwei Spieler (abwechselnd oder gleichzeitig)"
  },
  "targets": [
    {
      "id": "mega65",
      "system": "mega65",
      "cpu": "45gs02",
      "illegals": "deny",
      "emulator": "xemu"
    }
  ],
  "sources": [
    {
      "targets": [
        "mega65"
      ],
      "kind": "asm",
      "files": [
        "main.asm"
      ]
    }
  ],
  "main": "main.asm"
}
