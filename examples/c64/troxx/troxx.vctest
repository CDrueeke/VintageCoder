{
 "kind": "test",
 "target": "c64",
 "program": "build/main.prg",
 "trap": "$0340",
 "static": [
  {
   "check": "size",
   "segment": "PROGRAM",
   "max": 9000,
   "maxEnd": "$3000",
   "name": "Programm <= 9000 Byte, endet vor dem Zeichensatz-RAM ($3000)"
  },
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$90-$ff",
   "name": "Zeropage: $90 und hoeher bleibt dem KERNAL"
  }
 ],
 "tests": [
  {
   "name": "grid.draw: Ecke, Linie, T-Stueck, Innenraum (Zeichen und Farbe)",
   "call": "grid.draw",
   "expect": [
    "[$451] == 131",
    "[$452] == 128",
    "[$455] == 135",
    "[$471] == 132",
    "[$479] == 129",
    "[$47a] == 32",
    "([$d852] & 15) == 4",
    "([$d879] & 15) == 4"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "grid.draw: Kreuzung (gx 4, gy 4), Unterkante, Randspalten",
   "call": "grid.draw",
   "expect": [
    "[$4f5] == 130",
    "[$771] == 133",
    "[$791] == 134",
    "[$775] == 136",
    "[$4f1] == 137",
    "[$511] == 138",
    "[$539] == 129",
    "[$769] == 129"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "box_add: vierte Kante: vorgemerkt, 100 Punkte, BOXES_DONE + 1",
   "setup": {
    "x": 7,
    "mem": {
     "$43": 0,
     "$f": 0,
     "$b": [
      0,
      0,
      0
     ],
     "$e": 0,
     "$a": 3,
