; Shared part of the tiles_demo example (Atari 8 bit (ANTIC mode 2)): shows the tile library (#include <atari8bit/tiles.asm>) and holds the
; test routines for vcc test. The programs tiles_demo_*.asm differ only in tile size (DEMO_SET = 3 for
; 3x2, 2 for 2x2), TILE_SMC and TILE_MAPRAM; they set these switches and then include this file.
; Generated by tools/gen_tiles_demo.py (do not edit by hand).
.target atari8
.cpu sally { illegals = deny }
#include <atari8bit/tiles.asm>
#include <atari8bit/test.inc>

; ZP for the test routines (outside the tile group $F7-$FE)
.const ZP_CRC = $80             ; CRC-16 (2 bytes)
.const ZP_PTR = $82             ; pointer to the data to check (2 bytes)
.const ZP_X   = $84
.const ZP_Y   = $85
.const ZP_CNT = $86             ; counter (2 bytes)
.const AREA   = TILE_COLS * TILE_ROWS

.org $2000
start:  jmp main

; ---------------------------------------------------------------- Data and library
.if DEMO_SET == 3
.include "data_3x2.inc"
.include "expect_3x2.inc"
.else
.include "data_2x2.inc"
.include "expect_2x2.inc"
.endif

.ifndef DEMO_RLE
.const DEMO_RLE = 0                ; 1 = maps run-length encoded (levels_rle_*), TILE_RLE and TILE_MAPRAM come from the program file
.endif
.if DEMO_RLE
        tiles_use hg_c0, hg_col, hg_props, hg_tw, hg_th, hg_count, levels_rle_lo, levels_rle_hi, levels_tiles_w, levels_tiles_h
.else
        tiles_use hg_c0, hg_col, hg_props, hg_tw, hg_th, hg_count, levels_screens_lo, levels_screens_hi, levels_tiles_w, levels_tiles_h
.endif
.const FX = DEMO_FX
.const FY = DEMO_FY

; ---------------------------------------------------------------- Program: shows screen 0, then a few single tiles
main:
        test_begin                  ; mailbox mode: the program tests itself (see below), then shows the demo
        jsr selftest
        jsr setup_display
        jsr clear_all
        screen_draw lv1_id          ; select and draw screen 0
        tile_draw 3, 5, 2           ; tile 3 at tile position (5, 2), constants only
        tile_draw_color 1, 0, 0, 0
        tile_fill 4, FX, FY, 2, 2   ; 2 x 2 tiles of tile 4
        lda #1
        ldx #4
        ldy #6
        jsr tile_put                ; run time: A = tile, X = column, Y = row
        test_end

; Display list: 3 x 8 blank lines, 24 text lines in ANTIC mode 2 (40 columns) from TILE_SCREEN (LMS), character set in ROM ($E000).
; Mode 4 (multicolor text) differs only in the command byte ($44/$04 instead of $42/$02) and needs its own character set.
SDLSTL = $0230
CHBAS  = $02f4
setup_display:
        lda #<dlist
        sta SDLSTL
        lda #>dlist
        sta SDLSTL+1
        lda #$e0
        sta CHBAS
        rts

selftest:                        ; all tests in a row; each returns A = 0 if the screen CRC matches
        jsr t_screen1
        assert_a_eq 0
        jsr t_rows
        assert_a_eq 0
        jsr t_macros
        assert_a_eq 0
        jsr t_puts
        assert_a_eq 0
        jsr t_erase
        assert_a_eq 0
        jsr t_restore
        assert_a_eq 0
        jsr t_restore_bg
        assert_a_eq 0
        jsr t_row
        assert_a_eq 0
        ldx #SELF_X0
        ldy #SELF_Y0
        jsr t_map_get
        assert_a_eq SELF_T0
        ldx #SELF_X0
        ldy #SELF_Y0
        jsr t_prop
        assert_a_eq SELF_P0
        ldx #SELF_X1
        ldy #SELF_Y1
        jsr t_map_get
        assert_a_eq SELF_T1
        ldx #SELF_X1
        ldy #SELF_Y1
        jsr t_prop
        assert_a_eq SELF_P1
        ldx #SELF_X2
        ldy #SELF_Y2
        jsr t_map_get
        assert_a_eq SELF_T2
        ldx #SELF_X2
        ldy #SELF_Y2
        jsr t_prop
        assert_a_eq SELF_P2
        rts

; ---------------------------------------------------------------- Test routines (called by vcc test, see tiles_*.vctest)
; clear the screen (character = blank, color = blank_col)
clear_all:
        ldx #0
        lda #$00
.l:
        sta TILE_SCREEN + $0,x
        sta TILE_SCREEN + $100,x
        sta TILE_SCREEN + $200,x
        sta TILE_SCREEN + $2c0,x
        inx
        bne .l
        rts

; crc_area: CRC-16 (XMODEM) over AREA bytes from (ZP_PTR); X = mask for each byte -> result in ZP_CRC
crc_area:
        stx ZP_X
        lda #0
        sta ZP_CRC
        sta ZP_CRC+1
        lda #<AREA
        sta ZP_CNT
        lda #>AREA
        sta ZP_CNT+1
        ldy #0
.byte:  lda (ZP_PTR),y
        and ZP_X
        eor ZP_CRC+1
        sta ZP_CRC+1
        ldx #8
.bit:   asl ZP_CRC
        rol ZP_CRC+1
        bcc .nx
        lda ZP_CRC+1
        eor #$10
        sta ZP_CRC+1
        lda ZP_CRC
        eor #$21
        sta ZP_CRC
.nx:    dex
        bne .bit
        iny
        bne .pg
        inc ZP_PTR+1
.pg:    lda ZP_CNT
        bne .d1
        dec ZP_CNT+1
.d1:    dec ZP_CNT
        lda ZP_CNT
        ora ZP_CNT+1
        bne .byte
        rts

; check(exp_scr): A = 0 if the screen has the expected CRC; 1 = wrong (no color memory)
.macro check(exp_scr)
        lda #<TILE_SCREEN
        sta ZP_PTR
        lda #>TILE_SCREEN
        sta ZP_PTR+1
        ldx #$ff
        jsr crc_area
        lda ZP_CRC
        cmp #<exp_scr
        bne @bad1
        lda ZP_CRC+1
        cmp #>exp_scr
        bne @bad1
        lda #0
        rts
@bad1:  lda #1
        rts
.endmacro

t_screen1:                          ; whole screen 1
        jsr clear_all
        screen_draw lv2_id
        check EXP_S1_SCR

t_screen1_nocheck:
        jsr clear_all
        screen_draw lv2_id
        rts

t_draw_only:                        ; drawing only (for the cycle measurement)
        screen_draw lv2_id
        rts

t_rows:                             ; tile rows 3..5 of screen 3
        jsr clear_all
        screen_select lv3_id
        lda #3
        ldx #3
        jsr screen_draw_rows
        check EXP_ROWS_SCR

t_macros:
        jsr clear_all
        tile_draw 3, 5, 2
        tile_draw_color 1, 0, 0, 14
        tile_fill 4, FX, FY, 2, 2
        check EXP_MACRO_SCR

t_puts:
        jsr clear_all
        lda #5
        ldx #2
        ldy #3
        jsr tile_put
        lda #0
        ldx #levels_tiles_w - 1
        ldy #levels_tiles_h - 1
        jsr tile_put
        lda #3
        ldx #0
        ldy #0
        jsr tile_put
        check EXP_PUT_SCR

; t_erase - tile_erase: select screen 1 (lv2_id), draw only the map tiles at (3,4) and bottom right; output as t_screen1.
t_erase:
        jsr clear_all
        screen_select lv2_id
        ldx #3
        ldy #4
        jsr tile_erase
        ldx #levels_tiles_w - 1
        ldy #levels_tiles_h - 1
        jsr tile_erase
        check EXP_ERASE_SCR

; t_erase_at - tile_erase on its own for the test: ZP_X, ZP_Y = tile position (screen 1 is already selected, see setup mem).
t_erase_at:
        jsr tile_erase
        rts

; t_restore - tile_restore (rectangle 4 x 3 from (2,1) of the map of screen 1); output as t_screen1.
t_restore:
        jsr clear_all
        screen_select lv2_id
        tile_restore 2, 1, 4, 3
        check EXP_RESTORE_SCR

; t_restore_bg - background restore: draw screen 1, put a figure (tile 4, 3 x 2) over it, then redraw the rectangle;
;   the result must be screen 1 again.
t_restore_bg:
        jsr clear_all
        screen_draw lv2_id
        tile_fill 4, 2, 2, 3, 2
        tile_restore 2, 2, 3, 2
        check EXP_S1_SCR

; t_row - tile_row: fill tile row 5 with tile 3; output as t_screen1.
t_row:
        jsr clear_all
        tile_row 5, 3
        check EXP_ROW_SCR


t_map_get:                          ; X = column, Y = row of screen 2 (lv2_id) -> A = tile number
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp screen_map_get

t_prop:
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp tile_prop

; ---------------------------------------------------------------- Library run time (once, behind the program)
        tiles_runtime
        .assert * <= $3800, "Program exceeds the limit of free memory (screen, display list or map)"

        .org $3800                  ; display list (must not cross a 1 KB boundary)
dlist:  .byte $70,$70,$70
        .byte $42,<TILE_SCREEN,>TILE_SCREEN
        .repeat TILE_ROWS - 1
        .byte $02
        .endrepeat
        .byte $41,<dlist,>dlist
        .run start
