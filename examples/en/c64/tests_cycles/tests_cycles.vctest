{
  "kind": "test", "target": "c64", "program": "build/tests_cycles.prg", "mode": "measure",
  "static": [ { "check": "size", "max": "$0100" } ],
  "tests": [
    { "name": "Wait loop: at most 1284 cycles", "from": "messen", "to": "ende", "max": 1284, "timeoutMs": 10000 },
    { "name": "Wait loop: budget 1283 is too tight (must fail)", "from": "messen", "to": "ende", "max": 1283, "level": "hint", "timeoutMs": 10000 }
  ]
}
