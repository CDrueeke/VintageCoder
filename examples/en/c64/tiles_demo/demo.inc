; demo.inc - shared part of the tiles_demo example (C64): shows the tile library (#include <c64/tiles.asm>) and contains the
; check routines for vcc test.
;
; Layout of the example: the four programs tiles_demo_3x2_ptr.asm, tiles_demo_3x2_smc.asm, tiles_demo_2x2_ptr.asm and tiles_demo_2x2_smc.asm
; differ only in the tile size (DEMO_SET = 3 for 3x2 tiles, 2 for 2x2), in TILE_SMC (0 = pointer version of screen_draw,
; ROM-capable; 1 = self-modifying code, faster) and in TILE_MAPRAM (3x2_smc only: $C800, the map is copied there when a screen is
; selected). They set these switches and then include this file. Each has its own test file tiles_demo_<variant>.vctest.
;
; Data: data_3x2.inc or data_2x2.inc (tile set hg with 6 tiles and screen bank levels with 3 screens, in the export format of the tile
; editor) and expect_3x2.inc or expect_2x2.inc (expected checksums). All three files are generated by tools/gen_tiles_demo.py.
; Screens are counted from 0: screen 0 = lv1_id, screen 1 = lv2_id, screen 2 = lv3_id.
;
; Usage: `vcc build examples/c64/tiles_demo` builds the four PRG files; to run a PRG, the main program `main` clears the screen,
; draws screen 0 and then a few single tiles (tile_draw, tile_draw_color, tile_fill, tile_put). `vcc test examples/c64/tiles_demo`
; runs the static checks (overlap, zero page $02-$21 forbidden, cycle budget of tile_put, program ends before $2000);
; with `--backend vice` the tests also run in the emulator: they call the check routines t_* (below) through a trap, write
; screen and color RAM with the library and compare a CRC-16 over both areas with the independently computed reference
; (EXP_*), plus samples of single cells and results of screen_map_get, tile_prop and tile_put including cycle measurement.
;
; Memory map: $0801 BASIC line `10 SYS 2061` and `start: jmp main`, then data and library binding (tiles_use generates no
; code), the main program, the check routines and at the very end the subroutines of the library (tiles_runtime). Screen $0400,
; color RAM $D800 (library default, 40 x 25 characters). Zero page: library $F7-$FE (tz_sp, tz_cp, tz_mp, tz_t and tz_idx = $FE,
; the selected screen), check routines $22-$29 (see below). The trap of the tests is at $C000 on the C64 by default (free).
; Limits: the check routines are not an example of good game code but measuring aids; there is no return to BASIC (jmp * at the end
; of main).
.target c64
.cpu 6510 { illegals = deny }
#include <c64/tiles.asm>

; zero page for the check routines (outside the tile group $F7-$FE); the test file forbids $02-$21, so they start at $22
.const ZP_CRC = $22             ; CRC-16 (2 bytes)
.const ZP_PTR = $24             ; pointer to the data to check (2 bytes)
.const ZP_X   = $26             ; 1 byte: mask in crc_area, saved column (X) in t_map_get and t_prop
.const ZP_Y   = $27             ; 1 byte: saved row (Y) in t_map_get and t_prop
.const ZP_CNT = $28             ; remaining byte counter in crc_area (2 bytes: $28/$29)

.org $0801
.basicstub start
start:  jmp main                ; jump over data and library binding to the main program

; ---------------------------------------------------------------- Data and library
.if DEMO_SET == 3
.include "data_3x2.inc"         ; tile set hg (3x2) and screen bank levels (3 maps of 12 x 10 tiles)
.include "expect_3x2.inc"       ; expected values EXP_* (CRC-16) and MAP_TILES_W
.else
.include "data_2x2.inc"         ; tile set hg (2x2) and screen bank levels (3 maps of 15 x 10 tiles)
.include "expect_2x2.inc"
.endif

; Bind set hg and bank levels to the library (only sets assembler variables, generates no code)

.ifndef DEMO_RLE
.const DEMO_RLE = 0             ; 1 = maps run-length encoded (levels_rle_*), TILE_RLE and TILE_MAPRAM come from the program file
.endif
.if DEMO_RLE
        tiles_use hg_c0, hg_col, hg_props, hg_tw, hg_th, hg_count, levels_rle_lo, levels_rle_hi, levels_tiles_w, levels_tiles_h
.else
        tiles_use hg_c0, hg_col, hg_props, hg_tw, hg_th, hg_count, levels_screens_lo, levels_screens_hi, levels_tiles_w, levels_tiles_h
.endif


; ---------------------------------------------------------------- Program: shows screen 0 and a few single tiles on it
; main - main program (entry via `start`). Border and background black, clear the screen, draw screen 0 and then place single
;   tiles on top with the macros and with tile_put. Ends in an endless loop; changes all registers.
main:   sei
        lda #0
        sta VIC_BORDERCOLOR
        sta VIC_BGCOLOR0
        jsr clear_all
        screen_draw lv1_id          ; select screen 0 and draw it completely
        tile_draw 3, 5, 2           ; tile 3 at tile position (5, 2): character and tile color, constants only (macro, unrolled)
        tile_draw_color 1, 0, 0, COL_YELLOW   ; tile 1 at top left, but with color yellow instead of the tile color
        tile_fill 4, 6, 6, 2, 2     ; 2 x 2 tiles of tile 4
        lda #1
        ldx #4
        ldy #6
        jsr tile_put                ; run time: A = tile, X = column, Y = row
        jmp *

; ---------------------------------------------------------------- Check routines (called by vcc test, see tiles_demo_*.vctest)
; clear_all - fill the screen with the space ($20) and color RAM with 1 (white), so every check starts from the same state.
;   One loop over X = 0..255 writes four overlapping 256-byte windows (offsets 0, $100, $200, $2E8 = 744), 1000 cells in total.
;   Changes A, X and the flags.
clear_all:
        ldx #0
.l:     lda #$20
        sta TILE_SCREEN,x
        sta TILE_SCREEN+$100,x
        sta TILE_SCREEN+$200,x
        sta TILE_SCREEN+$2e8,x
        lda #1
        sta TILE_COLORRAM,x
        sta TILE_COLORRAM+$100,x
        sta TILE_COLORRAM+$200,x
        sta TILE_COLORRAM+$2e8,x
        inx
        bne .l
        rts

; crc_area - CRC-16 (XMODEM: polynomial $1021, start value 0, MSB first) over 1000 bytes.
;   Input: ZP_PTR = start address; X = mask that is ANDed with every byte before the calculation ($FF for the screen,
;   $0F for color RAM, whose upper four bits are unused). Output: ZP_CRC (low byte first). Changes A, X, Y,
;   ZP_PTR (points behind the area afterwards), ZP_CNT and ZP_X. Loop structure: load byte, mask, mix into the upper CRC byte,
;   shift eight times and mix in the polynomial ($1021) when a bit is shifted out; then advance pointer and counter.
crc_area:
        stx ZP_X
        lda #0
        sta ZP_CRC
        sta ZP_CRC+1
        lda #<1000
        sta ZP_CNT
        lda #>1000
        sta ZP_CNT+1
        ldy #0
.byte:  lda (ZP_PTR),y          ; (local label, not the directive .byte)
        and ZP_X
        eor ZP_CRC+1
        sta ZP_CRC+1
        ldx #8
.bit:   asl ZP_CRC
        rol ZP_CRC+1
        bcc .nx
        lda ZP_CRC+1
        eor #$10
        sta ZP_CRC+1
        lda ZP_CRC
        eor #$21
        sta ZP_CRC
.nx:    dex
        bne .bit
        iny
        bne .pg                     ; Y wrapped: pointer to the next page
        inc ZP_PTR+1
.pg:    lda ZP_CNT                  ; count down the 16-bit counter: carry into the upper byte when the lower one is 0
        bne .d1
        dec ZP_CNT+1
.d1:    dec ZP_CNT
        lda ZP_CNT
        ora ZP_CNT+1
        bne .byte
        rts

; check(exp_scr, exp_col) - macro: compares the CRC-16 of the screen with exp_scr and that of color RAM (bits 0-3 only) with exp_col.
;   Output: A = 0 if both match; 1 = screen wrong; 2 = color wrong (returns with RTS, so the macro ends the
;   calling check routine). Changes A, X, Y and the flags.
.macro check(exp_scr, exp_col)
        lda #<TILE_SCREEN
        sta ZP_PTR
        lda #>TILE_SCREEN
        sta ZP_PTR+1
        ldx #$ff
        jsr crc_area
        lda ZP_CRC
        cmp #<exp_scr
        bne @bad1
        lda ZP_CRC+1
        cmp #>exp_scr
        bne @bad1
        lda #<TILE_COLORRAM
        sta ZP_PTR
        lda #>TILE_COLORRAM
        sta ZP_PTR+1
        ldx #$0f
        jsr crc_area
        lda ZP_CRC
        cmp #<exp_col
        bne @bad2
        lda ZP_CRC+1
        cmp #>exp_col
        bne @bad2
        lda #0
        rts
@bad1:  lda #1
        rts
@bad2:  lda #2
        rts
.endmacro

; t_screen1 - test: draw screen 1 (lv2_id) completely and compare with the reference. Output: A = 0 (ok) or 1/2 as in check.
t_screen1:                          ; whole screen 1
        jsr clear_all
        screen_draw lv2_id
        check EXP_S1_SCR, EXP_S1_COL

; t_screen1_nocheck - like t_screen1, but without comparison (RTS at the end): for samples of single cells by the test.
t_screen1_nocheck:
        jsr clear_all
        screen_draw lv2_id
        rts

; t_draw_only - only screen_draw of screen 1, without clearing first and without comparison: for the cycle measurement of the whole tile layer.
t_draw_only:                        ; drawing only (for the cycle measurement)
        screen_draw lv2_id
        rts

; t_rows - test of screen_draw_rows: draw only tile rows 3..5 of screen 2 (lv3_id) and compare with the reference.
t_rows:                             ; tile rows 3..5 of screen 2
        jsr clear_all
        screen_select lv3_id
        lda #3
        ldx #3
        jsr screen_draw_rows
        check EXP_ROWS_SCR, EXP_ROWS_COL

; t_macros - test of the macros tile_draw, tile_draw_color and tile_fill on an empty screen; output as in t_screen1.
t_macros:
        jsr clear_all
        tile_draw 3, 5, 2
        tile_draw_color 1, 0, 0, 14
        tile_fill 4, 6, 6, 2, 2
        check EXP_MACRO_SCR, EXP_MACRO_COL

; t_puts - test of tile_put: tile 5 to (2, 3), tile 0 into the lower right corner and tile 3 to (0, 0); output as in t_screen1.
t_puts:
        jsr clear_all
        lda #5
        ldx #2
        ldy #3
        jsr tile_put
        lda #0
        ldx #levels_tiles_w - 1
        ldy #levels_tiles_h - 1
        jsr tile_put
        lda #3
        ldx #0
        ldy #0
        jsr tile_put
        check EXP_PUT_SCR, EXP_PUT_COL

; t_map_get - test of screen_map_get. Input: X = column, Y = row of the map of screen 1 (lv2_id). Output: A = tile number.
;   Saves X and Y in ZP_X/ZP_Y because screen_select changes the registers.
t_map_get:
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp screen_map_get

; t_prop - test of tile_prop. Input: X = column, Y = row of the map of screen 1 (lv2_id). Output: A = property byte of the tile there.
t_prop:
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp tile_prop

; t_erase - tile_erase: select screen 1 (lv2_id), draw only the map tiles at (3,4) and at the lower right; output as in t_screen1.
t_erase:
        jsr clear_all
        screen_select lv2_id
        ldx #3
        ldy #4
        jsr tile_erase
        ldx #levels_tiles_w - 1
        ldy #levels_tiles_h - 1
        jsr tile_erase
        check EXP_ERASE_SCR, EXP_ERASE_COL

; t_erase_at - tile_erase on its own for the test: ZP_X, ZP_Y = tile position (screen 1 is already selected, see setup mem).
t_erase_at:
        jsr tile_erase
        rts

; t_restore - tile_restore (rectangle 4 x 3 from (2,1) from the map of screen 1); output as in t_screen1.
t_restore:
        jsr clear_all
        screen_select lv2_id
        tile_restore 2, 1, 4, 3
        check EXP_RESTORE_SCR, EXP_RESTORE_COL

; t_restore_bg - background restoration: draw screen 1, put a figure (tile 4, 3 x 2) on top, then redraw the rectangle;
;   the result must be screen 1 again.
t_restore_bg:
        jsr clear_all
        screen_draw lv2_id
        tile_fill 4, 2, 2, 3, 2
        tile_restore 2, 2, 3, 2
        check EXP_S1_SCR, EXP_S1_COL

; t_row - tile_row: fill tile row 5 with tile 3; output as in t_screen1.
t_row:
        jsr clear_all
        tile_row 5, 3
        check EXP_ROW_SCR, EXP_ROW_COL

; ---------------------------------------------------------------- Run time of the library (once, behind the program)
        tiles_runtime                   ; subroutines screen_*, tile_put, tile_prop and the tables of the library
