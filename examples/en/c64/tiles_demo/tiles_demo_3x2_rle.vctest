{
 "kind": "test",
 "target": "c64",
 "program": "build/tiles_demo_3x2_rle.prg",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$02-$21"
  },
  {
   "check": "cycles",
   "label": "tile_put",
   "max": 190,
   "level": "error"
  },
  {
   "check": "expr",
   "name": "Programm endet vor $2000",
   "expr": "size(\"\") < $2000 - $0801"
  }
 ],
 "tests": [
  {
   "name": "screen_draw 1: screen and color RAM = reference",
   "call": "t_screen1",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw 1: samples top left / bottom right",
   "call": "t_screen1_nocheck",
   "expect": [
    "[$0400] == 31",
    "([$d800] & 15) == 5",
    "[$0401] == 34",
    "([$d801] & 15) == 5",
    "[$0402] == 37",
    "([$d802] & 15) == 5",
    "[$0428] == 40",
    "([$d828] & 15) == 5",
    "[$0429] == 43",
    "([$d829] & 15) == 5",
    "[$042a] == 46",
    "([$d82a] & 15) == 5",
    "[$06f1] == 45",
    "([$daf1] & 15) == 13",
    "[$06f2] == 48",
    "([$daf2] & 15) == 13",
    "[$06f3] == 51",
    "([$daf3] & 15) == 13",
    "[$0719] == 54",
    "([$db19] & 15) == 13",
    "[$071a] == 57",
    "([$db1a] & 15) == 13",
    "[$071b] == 60",
    "([$db1b] & 15) == 13"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw_rows 3..5 of screen 2: only these rows (reference)",
   "call": "t_rows",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_draw, tile_draw_color, tile_fill (reference)",
   "call": "t_macros",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put three times (reference)",
   "call": "t_puts",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put: tile 5 to (2,3), cycles",
   "setup": {
    "a": "5",
    "x": 2,
    "y": 3
   },
   "call": "tile_put",
   "expect": [
    "[$04f6] == 52",
    "([$d8f6] & 15) == 14",
    "[$04f7] == 55",
    "([$d8f7] & 15) == 14",
    "[$04f8] == 58",
    "([$d8f8] & 15) == 14",
    "[$051e] == 61",
    "([$d91e] & 15) == 14",
    "[$051f] == 64",
    "([$d91f] & 15) == 14",
    "[$0520] == 67",
    "([$d920] & 15) == 14"
   ],
   "timeoutMs": 2000,
   "cycles": {
    "max": 190,
    "level": "error"
   }
  },
  {
   "name": "tile_put: tile 0 to (11,9), cycles",
   "setup": {
    "a": "0",
    "x": 11,
    "y": 9
   },
   "call": "tile_put",
   "expect": [
    "[$06f1] == 17",
    "([$daf1] & 15) == 1",
    "[$06f2] == 20",
    "([$daf2] & 15) == 1",
    "[$06f3] == 23",
    "([$daf3] & 15) == 1",
    "[$0719] == 26",
    "([$db19] & 15) == 1",
    "[$071a] == 29",
    "([$db1a] & 15) == 1",
    "[$071b] == 32",
    "([$db1b] & 15) == 1"
   ],
   "timeoutMs": 2000,
   "cycles": {
    "max": 190,
    "level": "error"
   }
  },
  {
   "name": "tile_put: tile 3 to (0,0), cycles",
   "setup": {
    "a": "3",
    "x": 0,
    "y": 0
   },
   "call": "tile_put",
   "expect": [
    "[$0400] == 38",
    "([$d800] & 15) == 15",
    "[$0401] == 41",
    "([$d801] & 15) == 15",
    "[$0402] == 44",
    "([$d802] & 15) == 15",
    "[$0428] == 47",
    "([$d828] & 15) == 15",
    "[$0429] == 50",
    "([$d829] & 15) == 15",
    "[$042a] == 53",
    "([$d82a] & 15) == 15"
   ],
   "timeoutMs": 2000,
   "cycles": {
    "max": 190,
    "level": "error"
   }
  },
  {
   "name": "tile_erase twice: map tiles redrawn (reference)",
   "call": "t_erase",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_restore 4 x 3 from the map (reference)",
   "call": "t_restore",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_restore restores the background under a figure (= screen 1)",
   "call": "t_restore_bg",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_row: row 5 from tile 3 (reference)",
   "call": "t_row",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_map_get (0,0) of screen 1 = 2",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_map_get",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (0,0) of screen 1 = 1",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (11,9) of screen 1 = 4",
   "setup": {
    "x": 11,
    "y": 9
   },
   "call": "t_map_get",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (11,9) of screen 1 = 4",
   "setup": {
    "x": 11,
    "y": 9
   },
   "call": "t_prop",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (3,4) of screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_map_get",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (3,4) of screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_erase (3,4): cycles",
   "setup": {
    "x": 3,
    "y": 4,
    "mem": {
     "$fe": 1
    }
   },
   "call": "tile_erase",
   "cycles": {
    "max": 280,
    "level": "error"
   },
   "timeoutMs": 2000
  },
  {
   "name": "tile_restore_a 4 x 3 from (2,1): cycles",
   "setup": {
    "a": 4,
    "x": 2,
    "y": 1,
    "mem": {
     "$fe": 1,
     "$fd": 3
    }
   },
   "call": "tile_restore_a",
   "cycles": {
    "max": 4000,
    "level": "error"
   },
   "timeoutMs": 2000
  },
  {
   "name": "tile_row_a: row 5, cycles",
   "setup": {
    "a": 3,
    "y": 5
   },
   "call": "tile_row_a",
   "cycles": {
    "max": 2500,
    "level": "error"
   },
   "timeoutMs": 2000
  },
  {
   "name": "screen_draw 1 (whole tile layer) cycles",
   "call": "t_draw_only",
   "cycles": {
    "max": 40000,
    "level": "hint"
   },
   "timeoutMs": 20000
  },
  {
   "name": "RLE: map of screen 1 is unpacked at $c800",
   "call": "t_screen1_nocheck",
   "expect": [
    "[$c800] == 2",
    "[$c801] == 4",
    "[$c80d] == 2",
    "[$c877] == 4"
   ],
   "timeoutMs": 20000
  }
 ]
}
