{
  "format": 1,
  "project": {
    "name": "VIC-20: tiles_demo",
    "description": "Tile library #include <vic20/tiles.asm>: 3x2 and 2x2 tiles, pointer, SMC and RLE versions, test with vcc test"
  },
  "targets": [
    {
      "id": "vic20",
      "system": "vic20",
      "variant": "pal",
      "memory": "unexpanded",
      "cpu": "nmos6502",
      "illegals": "deny",
      "emulator": "vice"
    }
  ],
  "sources": [
    {
      "targets": [
        "vic20"
      ],
      "kind": "asm",
      "files": [
        "tiles_demo_3x2_ptr.asm",
        "tiles_demo_3x2_smc.asm",
        "tiles_demo_3x2_rle.asm",
        "tiles_demo_2x2_ptr.asm",
        "tiles_demo_2x2_smc.asm"
      ]
    }
  ],
  "main": "tiles_demo_3x2_ptr.asm"
}
