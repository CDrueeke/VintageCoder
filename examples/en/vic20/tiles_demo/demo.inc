; Common part of the tiles_demo example (unexpanded VIC-20): shows the tile library (#include <vic20/tiles.asm>) and contains the
; check routines for vcc test. The four programs tiles_demo_*.asm differ only in tile size (DEMO_SET = 3 for
; 3x2, 2 for 2x2), TILE_SMC and TILE_MAPRAM; they set these switches and then include this file.
; Generated by tools/gen_tiles_demo.py (do not change by hand).
.target vic20
.cpu 6502 { illegals = deny }
#include <vic20/tiles.asm>

; zero page for the check routines (outside the tile group $F7-$FE)
.const ZP_CRC = $22             ; CRC-16 (2 bytes)
.const ZP_PTR = $24             ; pointer to the data to be checked (2 bytes)
.const ZP_X   = $26
.const ZP_Y   = $27
.const ZP_CNT = $28             ; counter (2 bytes)
.const AREA   = TILE_COLS * TILE_ROWS

.org $1001
.basicstub start
start:  jmp main

; ---------------------------------------------------------------- Data and library
.if DEMO_SET == 3
.include "data_3x2.inc"
.include "expect_3x2.inc"
.else
.include "data_2x2.inc"
.include "expect_2x2.inc"
.endif

.ifndef DEMO_RLE
.const DEMO_RLE = 0                ; 1 = maps run-length encoded (levels_rle_*), TILE_RLE and TILE_MAPRAM come from the program file
.endif
.if DEMO_RLE
        tiles_use hg_c0, hg_col, hg_props, hg_tw, hg_th, hg_count, levels_rle_lo, levels_rle_hi, levels_tiles_w, levels_tiles_h
.else
        tiles_use hg_c0, hg_col, hg_props, hg_tw, hg_th, hg_count, levels_screens_lo, levels_screens_hi, levels_tiles_w, levels_tiles_h
.endif
.const FX = DEMO_FX
.const FY = DEMO_FY

; ---------------------------------------------------------------- Program: shows screen 0, then a few single tiles
main:
        sei
        lda #$08
        sta VIC_COLOR              ; background and border black
        jsr clear_all
        screen_draw lv1_id          ; select and draw screen 0
        tile_draw 3, 5, 2           ; tile 3 at tile position (5, 2), constants only
        tile_draw_color 1, 0, 0, 7
        tile_fill 4, FX, FY, 2, 2   ; 2 x 2 tiles of tile 4
        lda #1
        ldx #4
        ldy #6
        jsr tile_put                ; run time: A = tile, X = column, Y = row
        jmp *

; ---------------------------------------------------------------- Check routines (called by vcc test, see tiles_*.vctest)
; clear the screen (character = blank, color = blank_col)
clear_all:
        ldx #0
        lda #$20
.l:
        sta TILE_SCREEN + $0,x
        sta TILE_SCREEN + $fa,x
        lda #$01
        sta TILE_COLORRAM + $0,x
        sta TILE_COLORRAM + $fa,x
        lda #$20
        inx
        bne .l
        rts

; crc_area: CRC-16 (XMODEM) over AREA bytes from (ZP_PTR); X = mask for each byte -> result in ZP_CRC
crc_area:
        stx ZP_X
        lda #0
        sta ZP_CRC
        sta ZP_CRC+1
        lda #<AREA
        sta ZP_CNT
        lda #>AREA
        sta ZP_CNT+1
        ldy #0
.byte:  lda (ZP_PTR),y
        and ZP_X
        eor ZP_CRC+1
        sta ZP_CRC+1
        ldx #8
.bit:   asl ZP_CRC
        rol ZP_CRC+1
        bcc .nx
        lda ZP_CRC+1
        eor #$10
        sta ZP_CRC+1
        lda ZP_CRC
        eor #$21
        sta ZP_CRC
.nx:    dex
        bne .bit
        iny
        bne .pg
        inc ZP_PTR+1
.pg:    lda ZP_CNT
        bne .d1
        dec ZP_CNT+1
.d1:    dec ZP_CNT
        lda ZP_CNT
        ora ZP_CNT+1
        bne .byte
        rts

; check(exp_scr, exp_col): A = 0 if screen and color RAM have the expected CRC; 1 = screen wrong, 2 = color wrong
.macro check(exp_scr, exp_col)
        lda #<TILE_SCREEN
        sta ZP_PTR
        lda #>TILE_SCREEN
        sta ZP_PTR+1
        ldx #$ff
        jsr crc_area
        lda ZP_CRC
        cmp #<exp_scr
        bne @bad1
        lda ZP_CRC+1
        cmp #>exp_scr
        bne @bad1
        lda #<TILE_COLORRAM
        sta ZP_PTR
        lda #>TILE_COLORRAM
        sta ZP_PTR+1
        ldx #$0f
        jsr crc_area
        lda ZP_CRC
        cmp #<exp_col
        bne @bad2
        lda ZP_CRC+1
        cmp #>exp_col
        bne @bad2
        lda #0
        rts
@bad1:  lda #1
        rts
@bad2:  lda #2
        rts
.endmacro

t_screen1:                          ; whole screen 1
        jsr clear_all
        screen_draw lv2_id
        check EXP_S1_SCR, EXP_S1_COL

t_screen1_nocheck:
        jsr clear_all
        screen_draw lv2_id
        rts

t_draw_only:                        ; drawing only (for the cycle measurement)
        screen_draw lv2_id
        rts

t_rows:                             ; tile rows 3..5 of screen 3
        jsr clear_all
        screen_select lv3_id
        lda #3
        ldx #3
        jsr screen_draw_rows
        check EXP_ROWS_SCR, EXP_ROWS_COL

t_macros:
        jsr clear_all
        tile_draw 3, 5, 2
        tile_draw_color 1, 0, 0, 14
        tile_fill 4, FX, FY, 2, 2
        check EXP_MACRO_SCR, EXP_MACRO_COL

t_puts:
        jsr clear_all
        lda #5
        ldx #2
        ldy #3
        jsr tile_put
        lda #0
        ldx #levels_tiles_w - 1
        ldy #levels_tiles_h - 1
        jsr tile_put
        lda #3
        ldx #0
        ldy #0
        jsr tile_put
        check EXP_PUT_SCR, EXP_PUT_COL

; t_erase - tile_erase: select screen 1 (lv2_id), draw only the map tiles at (3,4) and at the bottom right; output like t_screen1.
t_erase:
        jsr clear_all
        screen_select lv2_id
        ldx #3
        ldy #4
        jsr tile_erase
        ldx #levels_tiles_w - 1
        ldy #levels_tiles_h - 1
        jsr tile_erase
        check EXP_ERASE_SCR, EXP_ERASE_COL

; t_erase_at - tile_erase on its own for the test: ZP_X, ZP_Y = tile position (screen 1 is already selected, see setup mem).
t_erase_at:
        jsr tile_erase
        rts

; t_restore - tile_restore (rectangle 4 x 3 from (2,1) from the map of screen 1); output like t_screen1.
t_restore:
        jsr clear_all
        screen_select lv2_id
        tile_restore 2, 1, 4, 3
        check EXP_RESTORE_SCR, EXP_RESTORE_COL

; t_restore_bg - background restore: draw screen 1, place a figure (tile 4, 3 x 2) over it, then redraw the rectangle;
;   the result must be screen 1 again.
t_restore_bg:
        jsr clear_all
        screen_draw lv2_id
        tile_fill 4, 2, 2, 3, 2
        tile_restore 2, 2, 3, 2
        check EXP_S1_SCR, EXP_S1_COL

; t_row - tile_row: fill tile row 5 with tile 3; output like t_screen1.
t_row:
        jsr clear_all
        tile_row 5, 3
        check EXP_ROW_SCR, EXP_ROW_COL


t_map_get:                          ; X = column, Y = row of screen 2 (lv2_id) -> A = tile number
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp screen_map_get

t_prop:
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp tile_prop

; ---------------------------------------------------------------- Run time of the library (once, after the program)
        tiles_runtime
        .assert * <= $1e00, "Program exceeds the limit of free memory (screen, display list or map)"
