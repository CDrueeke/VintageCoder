; Expected CRC-16 (XMODEM) over screen (1000 bytes) and color RAM (1000 bytes, mask $ff) per scenario; generated by tools/gen_tiles_demo.py
.const EXP_S1_SCR = $596a   ; screen number 1 completely drawn (t_screen1): screen
.const EXP_S1_COL = $072f   ; same: color RAM
.const EXP_ROWS_SCR = $7e4e   ; tile rows 3..5 of screen number 2 (t_rows): screen
.const EXP_ROWS_COL = $fbe3   ; same: color RAM
.const EXP_MACRO_SCR = $d3a3   ; macros tile_draw / tile_draw_color / tile_fill (t_macros): screen
.const EXP_MACRO_COL = $0c87   ; same: color RAM
.const EXP_PUT_SCR = $4586   ; tile_put calls (t_puts): screen
.const EXP_PUT_COL = $b0f2   ; same: color RAM
.const MAP_TILES_W = 12   ; width of the maps in tiles (as levels_tiles_w)
.const DEMO_FX = 6   ; tile column of the 2x2 rectangle in main and t_macros
.const DEMO_FY = 6   ; tile row of the rectangle
