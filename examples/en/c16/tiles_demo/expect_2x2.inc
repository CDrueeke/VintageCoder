.const EXP_MACRO_SCR = $3e13   ; macros tile_draw / tile_draw_color / tile_fill (t_macros): screen
.const EXP_MACRO_COL = $bd6f   ; same: color RAM
.const EXP_PUT_SCR = $d855   ; tile_put calls (t_puts): screen
.const EXP_PUT_COL = $d199   ; same: color RAM
