; =====================================================================================================================
; demo.inc - common part of the tiles_demo example (C16)
; =====================================================================================================================
; Generated by tools/gen_tiles_demo.py in the root directory of the repository (do not edit by hand: when the script runs again,
; changes are lost; comments then belong in the template of the script).
;
; PURPOSE
;   Shows the tile library (#include <plus4/tiles.asm>, system-neutral part data/sys/common/tiles.asm): a screen made of tiles
;   (tiles of 3x2 or 2x2 characters) is drawn into the text screen of the TED, plus single tiles, color variants and a
;   rectangle.  The file also contains test routines that vcc test calls in the emulator and that compare the screen and color memory
;   against an independently computed CRC-16 (tiles_demo_*.vctest).
;   The four programs tiles_demo_*.asm differ only in tile size (DEMO_SET = 3 for 3x2, 2 for 2x2), TILE_SMC (0 = pointer version,
;   1 = self-modifying code, faster, RAM only) and TILE_MAPRAM (3x2_smc only: the map is copied into a RAM buffer when selected);
;   they set these switches and then include this file.
;
; PROGRAM FLOW (label main)
;   Interrupts off (the example runs without KERNAL), border and background black, clear the screen (clear_all), draw screen 0
;   (screen_draw), then tile 3 at tile position (5,2), tile 1 in color $77 at (0,0), a 2x2 rectangle of tile 4 and, at run time
;   (tile_put), tile 1 at (4,6); then an endless loop.  There is no input.
;   Only the test calls the test routines t_* (entry through the label; according to the .vctest the trap is at $0340).
;
; HARDWARE USED
;   Mainly memory: screen $0C00 (character codes) and color RAM $0800 (TED color value per cell: hue, luminance, blinking);
;   plus the TED registers $FF19 (border color) and $FF15 (background color 0).
;
; MEMORY MAP
;   $1001 BASIC starter, then main, the test routines, the tile data and maps (data_*.inc) and the run time of the library
;   (tiles_runtime).  The program stays below $4000 (.assert at the end); with TILE_MAPRAM the map buffer is at $3000.
;   Zero page: tile group $F7-$FE (TILE_ZP of the library), test routines $22-$28; the .vctest file forbids $02-$21.
; =====================================================================================================================
.target c16
.cpu 7501 { illegals = deny }
#include <plus4/tiles.asm>

; ZP for the test routines (outside the tile group $F7-$FE)
.const ZP_CRC = $22             ; CRC-16 (2 bytes, low/high): result of crc_area
.const ZP_PTR = $24             ; pointer to the data to check (2 bytes)
.const ZP_X   = $26             ; saves X (mask in crc_area; column in t_map_get/t_prop)
.const ZP_Y   = $27             ; saves Y (row in t_map_get/t_prop)
.const ZP_CNT = $28             ; counter of the bytes still to check (2 bytes)
.const AREA   = TILE_COLS * TILE_ROWS   ; size of the checked area: 40 * 25 = 1000 bytes (screen or color RAM)

.org $1001                      ; start of BASIC memory on the C16 and Plus/4
.basicstub start                ; "10 SYS <start>": RUN jumps to start
start:  jmp main                ; (own label, so the entry point stays independent of the starter)

; ---------------------------------------------------------------- Data and library
; data_*.inc: tile set hg (planar cell tables hg_c0.., color hg_col, properties hg_props) and screen bank levels (maps, 3 screens);
; expect_*.inc: expected CRC-16 per test scenario and the size of the map (MAP_TILES_W) and the position of the rectangle (DEMO_FX/FY).
.if DEMO_SET == 3
.include "data_3x2.inc"
.include "expect_3x2.inc"
.else
.include "data_2x2.inc"
.include "expect_2x2.inc"
.endif

        tiles_use hg_c0, hg_col, hg_props, hg_tw, hg_th, hg_count, levels_screens_lo, levels_screens_hi, levels_tiles_w, levels_tiles_h
                                    ; connects tile set and screen bank with the library (macro, generates no code, only pointers/constants)
.const FX = DEMO_FX                 ; position (tile column/row) of the 2x2 rectangle in main: from expect_*.inc
.const FY = DEMO_FY

; ---------------------------------------------------------------- Program: shows screen 0, then a few single tiles
main:
        sei                         ; no interrupts: the example runs without KERNAL
        lda #0
        sta $ff19                  ; border black
        sta $ff15                  ; background black
        jsr clear_all
        screen_draw lv1_id          ; select and draw screen 0
        tile_draw 3, 5, 2           ; tile 3 at tile position (5, 2), constants only
        tile_draw_color 1, 0, 0, 119 ; tile 1 at top left with color $77 (yellow, luminance 7) instead of the tile color
        tile_fill 4, FX, FY, 2, 2   ; 2 x 2 tiles of tile 4
        lda #1
        ldx #4
        ldy #6
        jsr tile_put                ; run time: A = tile, X = column, Y = row
        jmp *

; ---------------------------------------------------------------- Test routines (called by vcc test, see tiles_*.vctest)
; clear_all: clear the screen (character = space $20, color = $71 = white, luminance 7).  Changes A, X.
;   Four stores per pass cover the 1000 cells: the pages +$000, +$100, +$200 and the overlapping rest +$2E8..+$3E7.
clear_all:
        ldx #0
        lda #$20
.l:
        sta TILE_SCREEN + $0,x
        sta TILE_SCREEN + $100,x
        sta TILE_SCREEN + $200,x
        sta TILE_SCREEN + $2e8,x
        lda #$71
        sta TILE_COLORRAM + $0,x
        sta TILE_COLORRAM + $100,x
        sta TILE_COLORRAM + $200,x
        sta TILE_COLORRAM + $2e8,x
        lda #$20
        inx
        bne .l
        rts

; crc_area: CRC-16 (XMODEM: polynomial $1021, start value 0, bitwise, highest bit first) over AREA bytes from (ZP_PTR).
;   Input: ZP_PTR = start, X = mask applied to each byte with AND ($FF = all bits; smaller masks hide e.g. color bits).
;   Output: ZP_CRC (low, high).  Changes A, X, Y, ZP_PTR+1, ZP_CNT, ZP_X.  Slow, but only used in the test.
crc_area:
        stx ZP_X
        lda #0
        sta ZP_CRC
        sta ZP_CRC+1
        lda #<AREA
        sta ZP_CNT
        lda #>AREA
        sta ZP_CNT+1
        ldy #0
.byte:  lda (ZP_PTR),y
        and ZP_X
        eor ZP_CRC+1
        sta ZP_CRC+1
        ldx #8
.bit:   asl ZP_CRC
        rol ZP_CRC+1
        bcc .nx
        lda ZP_CRC+1
        eor #$10
        sta ZP_CRC+1
        lda ZP_CRC
        eor #$21
        sta ZP_CRC
.nx:    dex
        bne .bit
        iny
        bne .pg
        inc ZP_PTR+1
.pg:    lda ZP_CNT
        bne .d1
        dec ZP_CNT+1
.d1:    dec ZP_CNT
        lda ZP_CNT
        ora ZP_CNT+1
        bne .byte
        rts

; check(exp_scr, exp_col): macro that checks the screen and the color RAM with crc_area and ends with rts (so it stands at the end of a t_ routine).
;   Output in A: 0 = both CRCs match the expectations; 1 = screen wrong; 2 = color RAM wrong.
.macro check(exp_scr, exp_col)
        lda #<TILE_SCREEN
        sta ZP_PTR
        lda #>TILE_SCREEN
        sta ZP_PTR+1
        ldx #$ff
        jsr crc_area
        lda ZP_CRC
        cmp #<exp_scr
        bne @bad1
        lda ZP_CRC+1
        cmp #>exp_scr
        bne @bad1
        lda #<TILE_COLORRAM
        sta ZP_PTR
        lda #>TILE_COLORRAM
        sta ZP_PTR+1
        ldx #$ff
        jsr crc_area
        lda ZP_CRC
        cmp #<exp_col
        bne @bad2
        lda ZP_CRC+1
        cmp #>exp_col
        bne @bad2
        lda #0
        rts
@bad1:  lda #1
        rts
@bad2:  lda #2
        rts
.endmacro

; ---- Test scenarios (each called with vcc test; screen number 0 = lv1_id, 1 = lv2_id, 2 = lv3_id; return A see check)
t_screen1:                          ; draw the whole screen with number 1 (lv2_id) and check it
        jsr clear_all
        screen_draw lv2_id
        check EXP_S1_SCR, EXP_S1_COL

t_screen1_nocheck:                  ; like t_screen1, but without CRC: the test reads single cells (samples)
        jsr clear_all
        screen_draw lv2_id
        rts

t_draw_only:                        ; drawing only (for the cycle measurement)
        screen_draw lv2_id
        rts

t_rows:                             ; tile rows 3..5 of screen number 2 (lv3_id) with screen_draw_rows (A = first row, X = count)
        jsr clear_all
        screen_select lv3_id
        lda #3
        ldx #3
        jsr screen_draw_rows
        check EXP_ROWS_SCR, EXP_ROWS_COL

t_macros:                           ; the macros tile_draw, tile_draw_color and tile_fill
        jsr clear_all
        tile_draw 3, 5, 2
        tile_draw_color 1, 0, 0, 14
        tile_fill 4, FX, FY, 2, 2
        check EXP_MACRO_SCR, EXP_MACRO_COL

t_puts:                             ; tile_put at run time: tile 5 at (2,3), tile 0 in the last corner, tile 3 at top left
        jsr clear_all
        lda #5
        ldx #2
        ldy #3
        jsr tile_put
        lda #0
        ldx #levels_tiles_w - 1
        ldy #levels_tiles_h - 1
        jsr tile_put
        lda #3
        ldx #0
        ldy #0
        jsr tile_put
        check EXP_PUT_SCR, EXP_PUT_COL

t_map_get:                          ; X = column, Y = row (in tiles) of screen number 1 (lv2_id) -> A = tile number (screen_map_get)
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp screen_map_get

t_prop:                             ; X = column, Y = row of screen number 1 (lv2_id) -> A = property byte of the tile (tile_prop)
        stx ZP_X
        sty ZP_Y
        screen_select lv2_id
        ldx ZP_X
        ldy ZP_Y
        jmp tile_prop

; ---------------------------------------------------------------- Library run time (once, after the program)
; Contains tile_put, screen_draw, screen_select_a etc. as subroutines (pointer or SMC version depending on TILE_SMC).
        tiles_runtime
        .assert * <= $4000, "Program exceeds the limit of free memory (screen, display list or map)"
