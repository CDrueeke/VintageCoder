{
 "kind": "test",
 "target": "vic20",
 "program": "build/tiles_demo_2x2_smc.prg",
 "trap": "$0340",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$02-$21"
  },
  {
   "check": "cycles",
   "label": "tile_put",
   "max": 150,
   "level": "error"
  }
 ],
 "tests": [
  {
   "name": "screen_draw 1: Bildschirm und Farb-RAM = Referenz",
   "call": "t_screen1",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw 1: Stichproben links oben / rechts unten",
   "call": "t_screen1_nocheck",
   "expect": [
    "[$1e00] == 45",
    "([$9600] & 15) == 13",
    "[$1e01] == 48",
    "([$9601] & 15) == 13",
    "[$1e16] == 51",
    "([$9616] & 15) == 13",
    "[$1e17] == 54",
    "([$9617] & 15) == 13",
    "[$1fcc] == 52",
    "([$97cc] & 15) == 14",
    "[$1fcd] == 55",
    "([$97cd] & 15) == 14",
    "[$1fe2] == 58",
    "([$97e2] & 15) == 14",
    "[$1fe3] == 61",
    "([$97e3] & 15) == 14"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw_rows 3..5 von Screen 2: nur diese Zeilen (Referenz)",
   "call": "t_rows",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_draw, tile_draw_color, tile_fill (Referenz)",
   "call": "t_macros",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put dreimal (Referenz)",
   "call": "t_puts",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put: Kachel 5 nach (2,3)",
   "setup": {
    "a": "5",
    "x": 2,
    "y": 3
   },
   "call": "tile_put",
   "expect": [
    "[$1e88] == 52",
    "([$9688] & 15) == 14",
    "[$1e89] == 55",
    "([$9689] & 15) == 14",
    "[$1e9e] == 58",
    "([$969e] & 15) == 14",
    "[$1e9f] == 61",
    "([$969f] & 15) == 14"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 0 nach (10,10)",
   "setup": {
    "a": "0",
    "x": 10,
    "y": 10
   },
   "call": "tile_put",
   "expect": [
    "[$1fcc] == 17",
    "([$97cc] & 15) == 1",
    "[$1fcd] == 20",
    "([$97cd] & 15) == 1",
    "[$1fe2] == 23",
    "([$97e2] & 15) == 1",
    "[$1fe3] == 26",
    "([$97e3] & 15) == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 3 nach (0,0)",
   "setup": {
    "a": "3",
    "x": 0,
    "y": 0
   },
   "call": "tile_put",
   "expect": [
    "[$1e00] == 38",
    "([$9600] & 15) == 15",
    "[$1e01] == 41",
    "([$9601] & 15) == 15",
    "[$1e16] == 44",
    "([$9616] & 15) == 15",
    "[$1e17] == 47",
    "([$9617] & 15) == 15"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (0,0) von Screen 1 = 4",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_map_get",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (0,0) von Screen 1 = 4",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_prop",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (10,10) von Screen 1 = 5",
   "setup": {
    "x": 10,
    "y": 10
   },
   "call": "t_map_get",
   "expect": [
    "a == 5"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (10,10) von Screen 1 = 5",
   "setup": {
    "x": 10,
    "y": 10
   },
   "call": "t_prop",
   "expect": [
    "a == 5"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (3,4) von Screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_map_get",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (3,4) von Screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  }
 ]
}
