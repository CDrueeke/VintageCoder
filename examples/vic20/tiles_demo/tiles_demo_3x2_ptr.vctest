{
 "kind": "test",
 "target": "vic20",
 "program": "build/tiles_demo_3x2_ptr.prg",
 "trap": "$0340",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$02-$21"
  },
  {
   "check": "cycles",
   "label": "tile_put",
   "max": 190,
   "level": "error"
  }
 ],
 "tests": [
  {
   "name": "screen_draw 1: Bildschirm und Farb-RAM = Referenz",
   "call": "t_screen1",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw 1: Stichproben links oben / rechts unten",
   "call": "t_screen1_nocheck",
   "expect": [
    "[$1e00] == 31",
    "([$9600] & 15) == 5",
    "[$1e01] == 34",
    "([$9601] & 15) == 5",
    "[$1e02] == 37",
    "([$9602] & 15) == 5",
    "[$1e16] == 40",
    "([$9616] & 15) == 5",
    "[$1e17] == 43",
    "([$9617] & 15) == 5",
    "[$1e18] == 46",
    "([$9618] & 15) == 5",
    "[$1fca] == 38",
    "([$97ca] & 15) == 15",
    "[$1fcb] == 41",
    "([$97cb] & 15) == 15",
    "[$1fcc] == 44",
    "([$97cc] & 15) == 15",
    "[$1fe0] == 47",
    "([$97e0] & 15) == 15",
    "[$1fe1] == 50",
    "([$97e1] & 15) == 15",
    "[$1fe2] == 53",
    "([$97e2] & 15) == 15"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw_rows 3..5 von Screen 2: nur diese Zeilen (Referenz)",
   "call": "t_rows",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_draw, tile_draw_color, tile_fill (Referenz)",
   "call": "t_macros",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put dreimal (Referenz)",
   "call": "t_puts",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put: Kachel 5 nach (2,3)",
   "setup": {
    "a": "5",
    "x": 2,
    "y": 3
   },
   "call": "tile_put",
   "expect": [
    "[$1e8a] == 52",
    "([$968a] & 15) == 14",
    "[$1e8b] == 55",
    "([$968b] & 15) == 14",
    "[$1e8c] == 58",
    "([$968c] & 15) == 14",
    "[$1ea0] == 61",
    "([$96a0] & 15) == 14",
    "[$1ea1] == 64",
    "([$96a1] & 15) == 14",
    "[$1ea2] == 67",
    "([$96a2] & 15) == 14"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 0 nach (6,10)",
   "setup": {
    "a": "0",
    "x": 6,
    "y": 10
   },
   "call": "tile_put",
   "expect": [
    "[$1fca] == 17",
    "([$97ca] & 15) == 1",
    "[$1fcb] == 20",
    "([$97cb] & 15) == 1",
    "[$1fcc] == 23",
    "([$97cc] & 15) == 1",
    "[$1fe0] == 26",
    "([$97e0] & 15) == 1",
    "[$1fe1] == 29",
    "([$97e1] & 15) == 1",
    "[$1fe2] == 32",
    "([$97e2] & 15) == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 3 nach (0,0)",
   "setup": {
    "a": "3",
    "x": 0,
    "y": 0
   },
   "call": "tile_put",
   "expect": [
    "[$1e00] == 38",
    "([$9600] & 15) == 15",
    "[$1e01] == 41",
    "([$9601] & 15) == 15",
    "[$1e02] == 44",
    "([$9602] & 15) == 15",
    "[$1e16] == 47",
    "([$9616] & 15) == 15",
    "[$1e17] == 50",
    "([$9617] & 15) == 15",
    "[$1e18] == 53",
    "([$9618] & 15) == 15"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (0,0) von Screen 1 = 2",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_map_get",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (0,0) von Screen 1 = 1",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (6,10) von Screen 1 = 3",
   "setup": {
    "x": 6,
    "y": 10
   },
   "call": "t_map_get",
   "expect": [
    "a == 3"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (6,10) von Screen 1 = 2",
   "setup": {
    "x": 6,
    "y": 10
   },
   "call": "t_prop",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (3,4) von Screen 1 = 4",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_map_get",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (3,4) von Screen 1 = 4",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_prop",
   "expect": [
    "a == 4"
   ],
   "timeoutMs": 2000
  }
 ]
}
