{
 "kind": "test",
 "target": "vic20",
 "program": "build/main.prg",
 "trap": "$0340",
 "static": [
  {
   "check": "size",
   "segment": "PROGRAM",
   "max": 3071,
   "maxEnd": "$1c00",
   "name": "Programm <= 3071 Byte (hartes Limit), endet vor dem Zeichensatz"
  },
  {
   "check": "size",
   "segment": "CHARSET",
   "min": 512,
   "max": 512,
   "name": "Zeichensatz 64 Zeichen"
  },
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$80-$ff"
  }
 ],
 "tests": [
  {
   "name": "grid.draw: Ecke, Linie, T-Stueck, Innenraum (Zeichen und Farbe)",
   "call": "grid.draw",
   "expect": [
    "[$1e16] == 29",
    "[$1e17] == 0",
    "[$1e1a] == 34",
    "[$1e1b] == 0",
    "[$1e2a] == 30",
    "[$1e2c] == 27",
    "[$1e2d] == 32",
    "[$1e30] == 27",
    "([$9616] & 15) == 6",
    "([$961a] & 15) == 6"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "grid.draw: Kreuzung (gx 4, gy 5) und unterste Zeile",
   "call": "grid.draw",
   "expect": [
    "[$1e00 + 22 * 6 + 4] == 28",
    "[$1e00 + 22 * 21] == 31",
    "[$1e00 + 22 * 21 + 20] == 33",
    "[$1e00 + 22 * 21 + 4] == 35"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes Segment 0: unten/rechts 0, oben/links 255",
   "setup": {
    "mem": {
     "$49": 2,
     "$4a": 0,
     "$4b": 1
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$34] == 0",
    "[$33] == 255"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "nb_boxes Segment 1: unten/rechts 1, oben/links 255",
   "setup": {
    "mem": {
     "$49": 6,
     "$4a": 0,
     "$4b": 1
    }
   },
   "call": "grid.nb_boxes",
   "expect": [
    "[$34] == 1",
    "[$33] == 255"
   ],
   "timeoutMs": 20000
  },
