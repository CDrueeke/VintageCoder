{
 "kind": "test",
 "target": "plus4",
 "program": "build/prallball.prg",
 "trap": "$7f00",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "expr",
   "name": "Puffer der Bestenliste liegen unter $8000 (das KERNAL liest/schreibt sie bei eingeblendetem ROM)",
   "expr": "hs_tmp + 128 < $8000"
  },
  {
   "check": "expr",
   "name": "Programm, Streifen, Levels und Lied enden vor den Puffern ab $C000",
   "expr": "song_patterns + 16 * 80 < $c000"
  },
  {
   "check": "expr",
   "name": "Streifen der Zeichen-Sprites sind eingebunden",
   "expr": "imd_0 > $1001"
  },
  {
   "check": "cycles",
   "label": "add_score",
   "max": 60
  }
 ],
 "tests": [
  {
   "name": "add_score: 0999 + 10 = 1009",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$20": 153,
     "$21": 9,
     "$22": 0
    },
    "a": "$10"
   },
   "call": "add_score",
   "expect": [
    "[$20] == $09",
    "[$21] == $10",
    "[$22] == 0"
   ]
  },
  {
   "name": "add_score: Uebertrag in die hoechsten Ziffern",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$20": 149,
     "$21": 153,
     "$22": 0
    },
    "a": "$10"
   },
   "call": "add_score",
   "expect": [
    "[$20] == $05",
    "[$21] == $00",
    "[$22] == $01"
   ]
  },
  {
   "name": "rand_byte: erste Zahl aus Startwert $A5/$5A",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$02": 165,
     "$03": 90
    }
   },
   "call": "rand_byte",
   "expect": [
    "a == $cb",
    "[$02] == $52",
    "[$03] == $99"
   ]
  },
  {
   "name": "set_vel: Stufe 0 Zone 3",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$1a": 0,
     "$50": 0
    },
    "a": "3"
   },
   "call": "set_vel",
   "expect": [
    "[$14] == $f0",
    "[$15] == $ff",
    "[$16] == $9b",
    "[$17] == $ff"
   ]
  },
  {
   "name": "set_vel: Stufe 5 Zone 0",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$1a": 5,
     "$50": 0
    },
    "a": "0"
   },
   "call": "set_vel",
   "expect": [
    "[$14] == $8c",
    "[$15] == $ff",
    "[$16] == $bd",
    "[$17] == $ff"
   ]
  },
  {
   "name": "set_vel: Stufe 15 Zone 7",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$1a": 15,
     "$50": 0
    },
    "a": "7"
   },
   "call": "set_vel",
   "expect": [
    "[$14] == $ac",
    "[$15] == $00",
    "[$16] == $9d",
    "[$17] == $ff"
   ]
  },
  {
   "name": "set_vel: \"schneller\" begrenzt auf Stufe 15",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$1a": 14,
     "$50": 1
    },
    "a": "2"
   },
   "call": "set_vel",
   "expect": [
    "[$14] == $a9",
    "[$16] == $4e"
   ]
  },
  {
   "name": "set_vel: \"langsamer\" begrenzt auf Stufe 0",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$1a": 2,
     "$50": 2
    },
    "a": "4"
   },
   "call": "set_vel",
   "expect": [
    "[$14] == $10",
    "[$16] == $9b"
   ]
  },
  {
   "name": "paddle_hit: Treffer in der Mitte -> Zone 4 und Abprall nach oben",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$18": 100,
     "$19": 0,
     "$45": 32,
     "$46": 4,
     "$1a": 0,
     "$50": 0,
     "$1b": 0,
     "$52": 0,
     "$5a": 0,
     "$12": 128,
     "$13": 44,
     "$17": 0,
     "$16": 64,
     "$10": 0,
     "$11": 29
    }
   },
   "call": "paddle_hit",
   "expect": [
    "fc",
    "[$14] == $10",
    "[$16] == $9b",
    "[$17] == $ff",
    "[$1b] == 1"
   ]
  },
  {
   "name": "paddle_hit: Ball neben dem Schlaeger -> kein Abprall",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$18": 100,
     "$19": 0,
     "$45": 32,
     "$46": 4,
     "$1a": 0,
     "$50": 0,
     "$1b": 0,
     "$52": 0,
     "$5a": 0,
     "$12": 128,
     "$13": 44,
     "$17": 0,
     "$16": 64,
     "$10": 0,
     "$11": 50
    }
   },
   "call": "paddle_hit",
   "expect": [
    "!fc",
    "[$1b] == 0"
   ]
  },
  {
   "name": "paddle_hit: linke Schlaegerkante -> Zone 0 (-60 Grad)",
   "setup": {
    "mem": {
     "$ff3f": 0,
     "$18": 100,
     "$19": 0,
     "$45": 32,
     "$46": 4,
     "$1a": 0,
