{
 "kind": "test",
 "target": "plus4",
 "program": "build/main.prg",
 "trap": "$0340",
 "static": [
  {
   "check": "size",
   "segment": "PROGRAM",
   "max": 12000,
   "maxEnd": "$4000",
   "name": "Programm <= 12000 Byte, endet vor dem Zeichensatz-RAM ($4000)"
  },
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$80-$ff",
   "name": "Zeropage: $80 und hoeher bleibt dem KERNAL"
  }
 ],
 "tests": [
  {
   "name": "grid.draw: Ecke, Linie, T-Stueck, Innenraum (Zeichen und Farbe)",
   "call": "grid.draw",
