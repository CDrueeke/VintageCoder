    "[$c53] == 131",
    "[$c54] == 128",
    "[$c57] == 135",
    "[$c73] == 132",
    "[$c7b] == 129",
    "[$c7c] == 32",
    "[$854] == 70",
    "[$87b] == 70",
    "[$4800] == 131",
    "[$4b01] == 70",
    "[$4820] == 132"
   ],
   "timeoutMs": 20000
  },
