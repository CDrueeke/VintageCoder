{
 "kind": "test",
 "target": "c16",
 "program": "build/tiles_demo_2x2_smc.prg",
 "trap": "$0340",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "zeropage",
   "forbid": "$02-$21"
  },
  {
   "check": "cycles",
   "label": "tile_put",
   "max": 150,
   "level": "error"
  }
 ],
 "tests": [
  {
   "name": "screen_draw 1: Bildschirm und Farb-RAM = Referenz",
   "call": "t_screen1",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw 1: Stichproben links oben / rechts unten",
   "call": "t_screen1_nocheck",
   "expect": [
    "[$0c00] == 31",
    "[$0800] == 85",
    "[$0c01] == 34",
    "[$0801] == 85",
    "[$0c28] == 37",
    "[$0828] == 85",
    "[$0c29] == 40",
    "[$0829] == 85",
    "[$0eec] == 24",
    "[$0aec] == 66",
    "[$0eed] == 27",
    "[$0aed] == 66",
    "[$0f14] == 30",
    "[$0b14] == 66",
    "[$0f15] == 33",
    "[$0b15] == 66"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "screen_draw_rows 3..5 von Screen 2: nur diese Zeilen (Referenz)",
   "call": "t_rows",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_draw, tile_draw_color, tile_fill (Referenz)",
   "call": "t_macros",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put dreimal (Referenz)",
   "call": "t_puts",
   "expect": [
    "a == 0"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "tile_put: Kachel 5 nach (2,3)",
   "setup": {
    "a": "5",
    "x": 2,
    "y": 3
   },
   "call": "tile_put",
   "expect": [
    "[$0cf4] == 52",
    "[$08f4] == 62",
    "[$0cf5] == 55",
    "[$08f5] == 62",
    "[$0d1c] == 58",
    "[$091c] == 62",
    "[$0d1d] == 61",
    "[$091d] == 62"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 0 nach (14,9)",
   "setup": {
    "a": "0",
    "x": 14,
    "y": 9
   },
   "call": "tile_put",
   "expect": [
    "[$0eec] == 17",
    "[$0aec] == 113",
    "[$0eed] == 20",
    "[$0aed] == 113",
    "[$0f14] == 23",
    "[$0b14] == 113",
    "[$0f15] == 26",
    "[$0b15] == 113"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_put: Kachel 3 nach (0,0)",
   "setup": {
    "a": "3",
    "x": 0,
    "y": 0
   },
   "call": "tile_put",
   "expect": [
    "[$0c00] == 38",
    "[$0800] == 111",
    "[$0c01] == 41",
    "[$0801] == 111",
    "[$0c28] == 44",
    "[$0828] == 111",
    "[$0c29] == 47",
    "[$0829] == 111"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (0,0) von Screen 1 = 2",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_map_get",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (0,0) von Screen 1 = 1",
   "setup": {
    "x": 0,
    "y": 0
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (14,9) von Screen 1 = 1",
   "setup": {
    "x": 14,
    "y": 9
   },
   "call": "t_map_get",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (14,9) von Screen 1 = 1",
   "setup": {
    "x": 14,
    "y": 9
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "screen_map_get (3,4) von Screen 1 = 2",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_map_get",
   "expect": [
    "a == 2"
   ],
   "timeoutMs": 2000
  },
  {
   "name": "tile_prop (3,4) von Screen 1 = 1",
   "setup": {
    "x": 3,
    "y": 4
   },
   "call": "t_prop",
   "expect": [
    "a == 1"
   ],
   "timeoutMs": 2000
  }
 ]
}
