; =====================================================================================================================
; balken.tur - Turbo BASIC XL ohne Zeilennummern: PROC/EXEC, WHILE, REPEAT und mehrzeiliges IF
; =====================================================================================================================
; Beim Bauen werden die Zeilen nummeriert; Turbo BASIC XL selbst wird zum Laden und Starten gebraucht
; (Datei BALKEN.BAS laden, dann RUN).  Strichpunkt-Zeilen sind Kommentare des Quelltextes und kommen nicht ins Programm.
;
; WAS ZU SEHEN IST
;   Im Textfenster unten stehen zwei Titelzeilen.  Darüber (Grafikstufe 7, 160 x 96 Punkte) bauen sich nacheinander 16 senkrechte
;   farbige Balken von links nach rechts auf, jeder 10 Punkte breit, in der Reihenfolge Rot, Grün, Blau, Rot, Grün, Blau ...
;   Zwischen zwei Balken vergeht eine halbe Sekunde.  Danach erscheint "TASTE DRUECKEN"; die Balken bleiben stehen, bis eine Taste
;   gedrückt wird.  Dann wird der Bildschirm gelöscht (GRAPHICS 0) und das Programm endet.
;   Zeigt: PROC/ENDPROC mit EXEC (Unterprogramme mit Namen statt GOSUB-Nummern), WHILE/WEND, REPEAT/UNTIL, mehrzeiliges
;   IF/ELSE/ENDIF, MOD, PAUSE (Turbo-BASIC-Erweiterungen; Standard-Atari-BASIC kennt diese Befehle nicht).
;
; VARIABLEN: spalte = laufende Balkennummer 0..15 (global, wird in den PROCs gelesen; es gibt keine lokalen Variablen);
;            farbe = Farbnummer 1..3 des aktuellen Balkens; x = linke Kante des Balkens in Punkten.
;
; Das Textfenster unten benutzt die Farbregister 1 (Schrift, nur die Helligkeit) und 2 (Hintergrund): deshalb Register 1 hell (14) und Register 2 dunkel (4),
; sonst wäre der Text unsichtbar.
; Grafikstufe 7 hat vier Farben: COLOR 0 ist der Hintergrund, COLOR 1..3 gehören zu den Farbregistern 0..2 (SETCOLOR Register, Farbton, Helligkeit).
GRAPHICS 7
SETCOLOR 0,4,6 : SETCOLOR 1,12,14 : SETCOLOR 2,8,4
EXEC titel
spalte=0
; je Durchlauf einen Balken zeichnen, 16 Durchläufe
WHILE spalte<16
  EXEC balken
  spalte=spalte+1
WEND
; warten auf eine Taste: Adresse 764 (CH) enthält 255, solange keine Taste gedrückt wurde
? "TASTE DRUECKEN";
REPEAT
  PAUSE 1
UNTIL PEEK(764)<>255
GRAPHICS 0
END

; Unterprogramm: zwei Titelzeilen im Textfenster ausgeben
PROC titel
  ? "TURBO BASIC XL"
  ? "PROC, EXEC, WHILE, REPEAT"
ENDPROC

; Unterprogramm: einen Balken zeichnen; Farbe 1 = Rot, 2 = Grün, 3 = Blau im Wechsel (spalte MOD 3)
PROC balken
  IF spalte MOD 3=0
    farbe=1
  ELSE
    IF spalte MOD 3=1
      farbe=2
    ELSE
      farbe=3
    ENDIF
  ENDIF
  x=spalte*10
  COLOR farbe
  FOR k=0 TO 9
    PLOT x+k,0 : DRAWTO x+k,79
  NEXT k
  ; PAUSE n wartet n Bilder (1/50 s bei PAL): 25 Bilder = eine halbe Sekunde
  PAUSE 25
ENDPROC
