{
 "kind": "test",
 "target": "atari8",
 "program": "build/main.xex",
 "static": [
  {
   "check": "expr",
   "name": "Programm endet vor dem Zeichensatz-RAM ($7000)",
   "expr": "PRG_END <= $7000"
  },
  {
   "check": "expr",
   "name": "Programm kleiner als 20 KB",
   "expr": "PRG_END - $2000 <= 20000"
  },
  {
   "check": "overlap"
  }
 ],
 "tests": [
  {
   "name": "grid.draw: Ecke, Linie, T-Stueck, Innenraum (Zeichen und Zustand)",
   "call": "grid.draw",
   "expect": [
    "[$8029] == 68",
    "[$802a] == 65",
    "[$802d] == 72",
    "[$8049] == 69",
    "[$8051] == 66",
    "[$8052] == 0",
    "([$8701] & 15) == 4",
    "([$8721] & 15) == 4"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "grid.draw: Kreuzung (gx 4, gy 4), Unterkante, Randspalten",
   "call": "grid.draw",
   "expect": [
    "[$80cd] == 67",
    "[$8349] == 70",
    "[$8369] == 71",
    "[$834d] == 73",
    "[$80c9] == 74",
    "[$80e9] == 75",
    "[$8111] == 66",
    "[$8341] == 66"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type Ecke (0, 0) = 3",
   "setup": {
    "mem": {
     "$db": 0,
     "$dc": 0
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 3"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type Knoten innen (4, 4) = 3",
   "setup": {
    "mem": {
     "$db": 4,
     "$dc": 4
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 3"
   ],
   "timeoutMs": 20000
  },
  {
   "name": "cell_type Ecke unten rechts (32, 20) = 3",
   "setup": {
    "mem": {
     "$db": 32,
     "$dc": 20
    }
   },
   "call": "grid.cell_type",
   "expect": [
    "a == 3"
   ],
   "timeoutMs": 20000
  },
