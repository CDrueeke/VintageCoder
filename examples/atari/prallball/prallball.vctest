{
 "kind": "test",
 "target": "atari8",
 "program": "build/prallball.xex",
 "static": [
  {
   "check": "overlap"
  },
  {
   "check": "expr",
   "name": "Programm endet vor dem Bildschirmspeicher bei $8000",
   "expr": "song_patterns + 16 * 80 < $8000"
  },
  {
   "check": "cycles",
   "label": "add_score",
   "max": 60
  }
 ],
 "tests": [
  {
   "name": "add_score: 0999 + 10 = 1009",
   "setup": {
    "mem": {
     "sc0": 153,
     "sc1": 9,
     "sc2": 0
    },
    "a": "$10"
   },
   "call": "add_score",
   "expect": [
    "[sc0] == $09",
    "[sc1] == $10",
    "[sc2] == 0"
   ],
   "cycles": {
    "max": 60
   }
  },
  {
   "name": "add_score: Uebertrag in die hoechsten Ziffern",
   "setup": {
    "mem": {
     "sc0": 149,
     "sc1": 153,
     "sc2": 0
    },
    "a": "$10"
   },
   "call": "add_score",
   "expect": [
    "[sc0] == $05",
    "[sc1] == $00",
    "[sc2] == $01"
   ]
  },
  {
   "name": "set_vel: Stufe 0 Zone 3",
   "setup": {
    "mem": {
     "speed": 0,
     "spdmod": 0
    },
    "a": "3"
   },
   "call": "set_vel",
   "expect": [
    "[vxl] == $f0",
    "[vxh] == $ff",
    "[vyl] == $9b",
    "[vyh] == $ff"
   ],
   "cycles": {
    "max": 70
   }
  },
  {
   "name": "set_vel: Stufe 5 Zone 0",
   "setup": {
    "mem": {
     "speed": 5,
     "spdmod": 0
    },
    "a": "0"
   },
   "call": "set_vel",
   "expect": [
    "[vxl] == $8c",
    "[vxh] == $ff",
    "[vyl] == $bd",
    "[vyh] == $ff"
   ],
   "cycles": {
    "max": 70
   }
  },
  {
   "name": "set_vel: Stufe 15 Zone 7",
   "setup": {
    "mem": {
     "speed": 15,
     "spdmod": 0
    },
    "a": "7"
   },
   "call": "set_vel",
   "expect": [
    "[vxl] == $ac",
    "[vxh] == $00",
    "[vyl] == $9d",
    "[vyh] == $ff"
   ],
   "cycles": {
    "max": 70
   }
  },
  {
   "name": "paddle_hit: Treffer in der Mitte -> Zone 4 und Abprall nach oben",
   "setup": {
    "mem": {
     "padl": 100,
     "padh": 0,
     "padw": 32,
     "zstep": 4,
     "speed": 0,
     "spdmod": 0,
     "hits": 0,
     "sticky": 0,
     "cb": 0,
     "byl": 128,
     "byh": 44,
     "vyh": 0,
     "vyl": 64,
     "mask": 0,
     "oyl": 0,
     "oyh": 0,
     "bxl": 0,
     "bxh": 29
    }
   },
   "call": "paddle_hit",
   "expect": [
    "fc",
    "[vxl] == $10",
    "[vyl] == $9b",
    "[vyh] == $ff",
    "[hits] == 1"
   ]
  },
  {
