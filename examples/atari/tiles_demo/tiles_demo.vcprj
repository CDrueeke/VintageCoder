{
  "format": 1,
  "project": {
    "name": "Atari 8 Bit: tiles_demo",
    "description": "Kachel-Bibliothek #include <atari8bit/tiles.asm>: 3x2- und 2x2-Kacheln, Zeiger- und SMC-Version, Test mit vcc test"
  },
  "targets": [
    {
      "id": "atari8",
      "system": "atari8",
      "model": "800xl",
      "variant": "pal",
      "cpu": "sally",
      "illegals": "deny",
      "emulator": "atari800"
    }
  ],
  "sources": [
    {
      "targets": [
        "atari8"
      ],
      "kind": "asm",
      "files": [
        "tiles_demo_3x2_ptr.asm",
        "tiles_demo_3x2_smc.asm",
        "tiles_demo_2x2_ptr.asm",
        "tiles_demo_2x2_smc.asm"
      ]
    }
  ],
  "main": "tiles_demo_3x2_ptr.asm"
}
