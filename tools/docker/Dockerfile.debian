# Bau-Image fuer Linux-Pakete (.deb) auf debian:stable: Rust (rustup), dpkg-deb, Python 3 und die Entwicklungsbibliotheken der IDE.
# Image: vc-build-debian   (Aufbau und Aufruf: Makefile, tools/linux-build.sh)
#   docker build --platform linux/amd64 -t vc-build-debian -f tools/docker/Dockerfile.debian tools/docker
FROM debian:stable
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl ca-certificates git python3 dpkg-dev xz-utils \
      libasound2-dev libxkbcommon-dev libwayland-dev libx11-dev libxcursor-dev libxrandr-dev libxi-dev \
      libgl1-mesa-dev libegl1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rwX /opt/rustup /opt/cargo
WORKDIR /src
