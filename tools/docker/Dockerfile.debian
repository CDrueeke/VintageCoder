# Bau-Image fuer Linux-Pakete (.deb) auf debian:stable: Rust (rustup), dpkg-deb, Python 3 die Entwicklungsbibliotheken der IDE (egui) und der Tauri-Oberflaeche (WebKitGTK, GTK 3, Node 22).
# Image: vc-build-debian   (Aufbau und Aufruf: Makefile, tools/linux-build.sh)
#   docker build --platform linux/amd64 -t vc-build-debian -f tools/docker/Dockerfile.debian tools/docker
FROM debian:stable
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl ca-certificates git python3 dpkg-dev xz-utils \
      libasound2-dev libxkbcommon-dev libwayland-dev libx11-dev libxcursor-dev libxrandr-dev libxi-dev \
      libgl1-mesa-dev libegl1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rwX /opt/rustup /opt/cargo
RUN apt-get update && apt-get install -y --no-install-recommends \
      libwebkit2gtk-4.1-dev libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*
# Tauri-Oberflaeche (ui/ mit vite, Programm aus crates/vc-shell): Node 22 (feste Version, Pruefsumme gegen SHASUMS256.txt), WebKitGTK 4.1 und GTK 3.
ARG NODE_VERSION=22.23.5
RUN curl -fsSLO https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
    && curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt | grep " node-v${NODE_VERSION}-linux-x64.tar.xz$" | sha256sum -c - \
    && tar -xJf node-v${NODE_VERSION}-linux-x64.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
    && rm node-v${NODE_VERSION}-linux-x64.tar.xz && node --version && npm --version
WORKDIR /src
