# Bau-Image fuer Linux-Pakete (.rpm) auf openSUSE Tumbleweed: Rust (rustup), rpmbuild, Python 3 die Entwicklungsbibliotheken der IDE (egui) und der Tauri-Oberflaeche (WebKitGTK, GTK 3, Node 22).
# Image: vc-build-opensuse   (Aufbau und Aufruf: Makefile, tools/linux-build.sh)
#   docker build --platform linux/amd64 -t vc-build-opensuse -f tools/docker/Dockerfile.opensuse tools/docker
FROM opensuse/tumbleweed
ENV LANG=C.UTF-8 RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN zypper --non-interactive install -y gcc gcc-c++ make pkg-config curl git python3 rpm-build tar gzip xz \
      alsa-devel libxkbcommon-devel wayland-devel libX11-devel libXcursor-devel libXrandr-devel libXi-devel \
      Mesa-libGL-devel Mesa-libEGL-devel \
    && zypper clean --all
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && chmod -R a+rwX /opt/rustup /opt/cargo
RUN zypper --non-interactive install -y webkitgtk3-devel gtk3-devel libsoup-devel \
    && zypper clean --all
# Tauri-Oberflaeche (ui/ mit vite, Programm aus crates/vc-shell): Node 22 (feste Version, Pruefsumme gegen SHASUMS256.txt), WebKitGTK 4.1 und GTK 3.
ARG NODE_VERSION=22.23.5
RUN curl -fsSLO https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
    && curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt | grep " node-v${NODE_VERSION}-linux-x64.tar.xz$" | sha256sum -c - \
    && tar -xJf node-v${NODE_VERSION}-linux-x64.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
    && rm node-v${NODE_VERSION}-linux-x64.tar.xz && node --version && npm --version
WORKDIR /src
